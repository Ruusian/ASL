pause_dashboard() {
    echo ""
    read -r -p "Press Enter to return to the dashboard..." _
}

draw_bar() {
    local pct="${1:-0}" width="${2:-10}" filled empty bar_color i
    pct="${pct%%[^0-9]*}"
    [ -z "$pct" ] && pct=0
    [ "$pct" -gt 100 ] && pct=100
    [ "$pct" -lt 0 ] && pct=0
    filled=$(( (pct * width) / 100 ))
    empty=$(( width - filled ))
    if [ "$pct" -ge 85 ]; then bar_color="$C_RED"
    elif [ "$pct" -ge 70 ]; then bar_color="$C_YELLOW"
    else bar_color="$C_GREEN"; fi
    printf '%s' "$bar_color"
    for ((i=0; i<filled; i++)); do printf '█'; done
    printf '%s' "$C_DIM"
    for ((i=0; i<empty; i++)); do printf '░'; done
    printf '%s' "$C_RESET"
}

asl_uptime() {
    local up d h m
    up=$(awk '{printf "%d", $1}' /proc/uptime 2>/dev/null || true)
    [ -n "$up" ] && [ "$up" -gt 0 ] 2>/dev/null || up=$(asl_exec "awk '{printf \"%d\", \$1}' /proc/uptime 2>/dev/null" 2>/dev/null | tr -d '[:space:]')
    [ -n "$up" ] || { printf '?'; return; }
    d=$((up / 86400)); up=$((up % 86400))
    h=$((up / 3600)); m=$(((up % 3600) / 60))
    if [ "$d" -gt 0 ]; then printf '%dd %dh' "$d" "$h"
    elif [ "$h" -gt 0 ]; then printf '%dh %02dm' "$h" "$m"
    else printf '%dm' "$m"; fi
}

asl_svc_uptime() {
    local prefix="${PREFIX:-/data/data/com.termux/files/usr}"
    local start_file="$prefix/tmp/asl-service.start_time"
    if [ -f "$start_file" ]; then
        local start_t now_t diff_t s_d s_h s_m
        start_t=$(cat "$start_file" 2>/dev/null | tr -d '[:space:]')
        now_t=$(date +%s 2>/dev/null || echo 0)
        if [ -n "$start_t" ] && [[ "$start_t" =~ ^[0-9]+$ ]] && [ "$now_t" -ge "$start_t" ]; then
            diff_t=$((now_t - start_t))
            s_d=$((diff_t / 86400)); diff_t=$((diff_t % 86400))
            s_h=$((diff_t / 3600)); s_m=$(((diff_t % 3600) / 60))
            if [ "$s_d" -gt 0 ]; then printf '%dd %dh' "$s_d" "$s_h"
            elif [ "$s_h" -gt 0 ]; then printf '%dh %02dm' "$s_h" "$s_m"
            elif [ "$s_m" -gt 0 ]; then printf '%dm' "$s_m"
            else printf '%ds' "$diff_t"; fi
            return
        fi
    fi
    printf 'N/A'
}

asl_cpu_freq() {
    local f
    f=$(cat /sys/devices/system/cpu/cpu0/cpufreq/scaling_cur_freq 2>/dev/null || asl_exec "cat /sys/devices/system/cpu/cpu0/cpufreq/scaling_cur_freq" 2>/dev/null)
    f=$(printf '%s' "$f" | tr -d '[:space:]')
    if [ -n "$f" ] && [[ "$f" =~ ^[0-9]+$ ]] && [ "$f" -gt 0 ]; then
        printf '%dMHz' "$((f / 1000))"
    else
        printf '?'
    fi
}

asl_host_ip() {
    local ip
    ip=$(ip -o -4 addr show 2>/dev/null | awk '$2 != "lo" {sub(/\/.*/, "", $4); print $4; exit}')
    [ -n "$ip" ] || ip=$(ifconfig 2>/dev/null | awk '/inet / && !/127.0.0.1/ {sub(/addr:/, ""); print $2; exit}')
    printf '%s' "${ip:-127.0.0.1}"
}

batt_temp_c() {
    local raw
    raw=$(cat /sys/class/power_supply/battery/temp 2>/dev/null | tr -d '[:space:]')
    if [[ "$raw" =~ ^[0-9]+$ ]] && [ "$raw" -gt 0 ]; then
        if [ "$raw" -gt 1000 ]; then printf '%d' "$((raw / 1000))"
        elif [ "$raw" -gt 100 ]; then printf '%d' "$((raw / 10))"
        else printf '%d' "$raw"; fi
        return
    fi
    asl_exec "dumpsys battery" 2>/dev/null | awk '/temperature:/ {printf "%d", int($2 / 10); exit}'
}

asl_cpu_temp_c() {
    local zone type raw temp
    for zone in /sys/class/thermal/thermal_zone*; do
        [ -d "$zone" ] || continue
        type=$(cat "$zone/type" 2>/dev/null | tr '[:upper:]' '[:lower:]')
        case "$type" in
            *cpu*) ;;
            *) continue ;;
        esac
        raw=$(cat "$zone/temp" 2>/dev/null | tr -d '[:space:]')
        [[ "$raw" =~ ^[0-9]+$ ]] || continue
        if [ "$raw" -gt 1000 ]; then temp=$((raw / 1000)); else temp=$raw; fi
        if [ "$temp" -ge 1 ] && [ "$temp" -le 125 ]; then
            printf '%d' "$temp"
            return
        fi
    done
}

asl_gpu_cached() {
    local now cache_file cache_time cache_prof
    now=$(date +%s 2>/dev/null || echo 0)
    cache_file="${TMPDIR:-${PREFIX:-/data/data/com.termux/files/usr}/tmp}/.asl_gpu_cache"

    if [ -n "${ASL_GPU_CACHE_T:-}" ] && [ "$((now - ASL_GPU_CACHE_T))" -lt 30 ] && [ -n "${ASL_GPU_PROFILE:-}" ]; then
        return 0
    fi

    if [ -f "$cache_file" ]; then
        read -r cache_time cache_prof < "$cache_file" 2>/dev/null || true
        if [ -n "$cache_time" ] && [[ "$cache_time" =~ ^[0-9]+$ ]] && [ "$((now - cache_time))" -lt 30 ] && [ -n "$cache_prof" ]; then
            ASL_GPU_CACHE_T=$cache_time
            ASL_GPU_PROFILE=$cache_prof
            return 0
        fi
    fi

    asl_gpu_detect
    ASL_GPU_CACHE_T=$now
    printf '%s %s\n' "$now" "${ASL_GPU_PROFILE:-generic-virgl}" > "$cache_file" 2>/dev/null || true
}

asl_wan_ping_cached() {
    local now cache_file cache_time cache_ping
    now=$(date +%s 2>/dev/null || echo 0)
    cache_file="${TMPDIR:-${PREFIX:-/data/data/com.termux/files/usr}/tmp}/.asl_ping_cache"

    if [ -f "$cache_file" ]; then
        read -r cache_time cache_ping < "$cache_file" 2>/dev/null || true
        if [ -n "$cache_time" ] && [[ "$cache_time" =~ ^[0-9]+$ ]] && [ "$((now - cache_time))" -lt 15 ] && [ -n "$cache_ping" ]; then
            printf '%s' "$cache_ping"
            return 0
        fi
    fi

    cache_ping=$(ping -c 1 -W 1 -w 1 1.1.1.1 2>/dev/null | awk -F'/' '/rtt/ {printf "%dms", $5}')
    [ -n "$cache_ping" ] || cache_ping="online"
    printf '%s %s\n' "$now" "$cache_ping" > "$cache_file" 2>/dev/null || true
    printf '%s' "$cache_ping"
}

asl_is_sshd_running() {
    pgrep -f "sshd" >/dev/null 2>&1 || su -c "pgrep -f sshd" >/dev/null 2>&1 || asl_exec "pgrep -f sshd" >/dev/null 2>&1
}

asl_is_omniroute_running() {
    pgrep -f "omniroute" >/dev/null 2>&1 || su -c "pgrep -f omniroute" >/dev/null 2>&1 || (timeout 1 bash -c 'cat < /dev/null > /dev/tcp/127.0.0.1/20128') 2>/dev/null
}

asl_remote_summary() {
    local active=()
    if asl_is_sshd_running; then active+=("LAN:8022"); fi
    if [ -f "$PREFIX/tmp/asl-oracle.state" ] && pgrep -f "ssh.*130.210.19.7" >/dev/null 2>&1; then active+=("Oracle"); fi
    if [ -f "$PREFIX/tmp/asl-serveo.state" ] && pgrep -f "serveo.net" >/dev/null 2>&1; then active+=("Serveo"); fi
    if [ -f "$PREFIX/tmp/asl-ngrok.state" ] && pgrep -f "ngrok.*tcp" >/dev/null 2>&1; then active+=("Ngrok"); fi
    if [ ${#active[@]} -gt 0 ]; then
        printf '%s' "${active[*]}"
    else
        printf 'OFF'
    fi
}

asl_remote_details() {
    local details=()
    local user pass host_ip
    local prefix="${PREFIX:-/data/data/com.termux/files/usr}"
    user=$(whoami 2>/dev/null || echo "user")
    if [ -f "$HOME/.asl/remote_password" ]; then
        pass="configured"
    else
        pass="not configured"
    fi
    host_ip=$(asl_host_ip)

    if asl_is_sshd_running; then
        details+=("* LAN SSH (Host):  ssh -p 8022 ${user}@${host_ip}")
    fi
    if [ -f "$prefix/tmp/asl-oracle.state" ] && pgrep -f "ssh.*130.210.19.7" >/dev/null 2>&1; then
        details+=("* Oracle VPS:  ssh -J ubuntu@130.210.19.7 -p 2222 ${user}@127.0.0.1")
    elif [ -f "$HOME/.ssh/oracle_vps.key" ] && [ -f "$prefix/tmp/asl-oracle.state" ]; then
        details+=("* Oracle VPS:      Standby (Run 'asl remote oracle start')")
    fi
    if [ -f "$prefix/tmp/asl-serveo.state" ] && pgrep -f "serveo.net" >/dev/null 2>&1; then
        local s_alias="asl-${user}"
        if [ -f "$HOME/.asl/serveo_alias.txt" ] && [ -s "$HOME/.asl/serveo_alias.txt" ]; then
            s_alias=$(cat "$HOME/.asl/serveo_alias.txt" 2>/dev/null)
        elif [ -n "${ASL_SERVEO_ALIAS:-}" ]; then
            s_alias="$ASL_SERVEO_ALIAS"
        fi
        details+=("* Serveo Tunnel:   ssh -J serveo.net ${user}@${s_alias}")
    fi
    if [ -f "$prefix/tmp/asl-ngrok.state" ] && pgrep -f "ngrok.*tcp" >/dev/null 2>&1; then
        local ng_url ng_host ng_port ng_json
        ng_json=$(curl -s --max-time 0.2 --connect-timeout 0.2 http://127.0.0.1:4040/api/tunnels 2>/dev/null)
        ng_url=$(echo "$ng_json" | grep -oE 'tcp://[^"]+' | head -1)
        if [ -n "$ng_url" ]; then
            ng_host=$(echo "$ng_url" | sed -E 's|tcp://([^:]+):.*|\1|')
            ng_port=$(echo "$ng_url" | sed -E 's|tcp://([^:]+:([0-9]+))|\1|' | sed -E 's|.*:||')
            details+=("* Ngrok Tunnel:      ssh -p ${ng_port} ${user}@${ng_host}")
        else
            details+=("* Ngrok Tunnel:      Active (Fetching tunnel URL...)")
        fi
    fi

    if [ ${#details[@]} -gt 0 ]; then
        local d_title="Remote Access Endpoints (Password: ${pass})"
        local dash_cnt=$(( 74 - 7 - ${#d_title} ))
        local dashes=""
        for ((i=0; i<dash_cnt; i++)); do dashes="${dashes}─"; done
        printf "%s├── %sRemote Access Endpoints%s (Password: %s%s%s) %s%s─┤%s\n" \
            "$C_CYAN" "$C_YELLOW$C_BOLD" "$C_CYAN" "$C_GREEN$C_BOLD" "$pass" "$C_CYAN" "$C_SHADOW" "$dashes" "$C_RESET"
        local d
        for d in "${details[@]}"; do
            printf "%s│%s  %s%-68.68s  %s│%s\n" "$C_CYAN" "$C_RESET" "$C_CYAN" "$d" "$C_CYAN" "$C_RESET"
        done
    fi
}

overview() {
    local mode="${1:-full}"
    local desktop_state desktop_status x11_socket
    local mem_total mem_avail mem_used mem_pct disk_data load_avg
    local swap_total swap_free swap_used swap_pct governor
    local batt_level batt_temp cpu_temp batt_str cpu_str host_ip wlock_status
    local up_str freq_str swap_from_zram remote_summary audio_status omni_lbl

    host_ip=$(asl_host_ip)

    wlock_status="OFF"
    local wlock_lbl=""
    if dumpsys power 2>/dev/null | grep -q "termux:service-wakelock" || su -c "dumpsys power" 2>/dev/null | grep -q "termux:service-wakelock" || pgrep -f "termux-wake-lock" >/dev/null 2>&1; then
        wlock_status="ON"
    fi
    wlock_lbl="$(status_badge "$wlock_status" 4)"

    x11_socket="${TMPDIR:-${PREFIX:-/data/data/com.termux/files/usr}/tmp}/.X11-unix/X0"
    desktop_state=$(bash "$ASL_DIR/desktop/start-desktop.sh" status 2>/dev/null | tr '\n' ' ')
    desktop_state=${desktop_state#Desktop: }
    desktop_state=${desktop_state% }
    desktop_status=${desktop_state%% *}
    asl_gpu_cached

    mem_total=$(awk '/MemTotal/ {print int($2/1024)}' /proc/meminfo 2>/dev/null || echo 0)
    mem_avail=$(awk '/MemAvailable/ {print int($2/1024)}' /proc/meminfo 2>/dev/null || echo 0)
    if [ "$mem_total" -gt 0 ]; then
        mem_used=$((mem_total - mem_avail))
        mem_pct=$((mem_used * 100 / mem_total))
    else
        mem_used=0; mem_pct=0
    fi

    swap_from_zram=0
    swap_total=$(awk '/SwapTotal/ {print int($2/1024)}' /proc/meminfo 2>/dev/null || echo 0)
    swap_free=$(awk '/SwapFree/ {print int($2/1024)}' /proc/meminfo 2>/dev/null || echo 0)
    if [ "$swap_total" -le 0 ]; then
        local zram_size zram_used_raw
        zram_size=$(asl_exec "cat /sys/block/zram0/disksize 2>/dev/null" 2>/dev/null | tr -d '[:space:]')
        zram_used_raw=$(asl_exec "cat /sys/block/zram0/mem_used_total 2>/dev/null" 2>/dev/null | tr -d '[:space:]')
        if [ -n "$zram_size" ] && [ "$zram_size" -gt 0 ] 2>/dev/null; then
            swap_total=$((zram_size / 1048576))
            swap_used=$(( ${zram_used_raw:-0} / 1048576 ))
            [ "$swap_used" -gt "$swap_total" ] && swap_used=$swap_total
            if [ "$swap_total" -gt 0 ]; then
                swap_pct=$((swap_used * 100 / swap_total))
            else
                swap_pct=0
            fi
            swap_from_zram=1
        fi
    fi
    if [ "$swap_from_zram" -eq 0 ]; then
        if [ "$swap_total" -gt 0 ]; then
            swap_used=$((swap_total - swap_free))
            swap_pct=$((swap_used * 100 / swap_total))
        else
            swap_used=0; swap_pct=0
        fi
    fi

    governor=$(cat /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor 2>/dev/null || echo "unknown")
    disk_data=$(df -h /data 2>/dev/null | awk 'NR==2 {print $4 " free of " $2}')
    [ -n "$disk_data" ] || disk_data="unknown"
    load_avg=$(cat /proc/loadavg 2>/dev/null || asl_exec "cat /proc/loadavg" 2>/dev/null)
    load_avg=$(printf '%s' "$load_avg" | cut -d' ' -f1-3)
    [ -n "$load_avg" ] || load_avg="unknown"

    batt_level=$(cat /sys/class/power_supply/battery/capacity 2>/dev/null || asl_exec "dumpsys battery" 2>/dev/null)
    batt_level=$(printf '%s' "$batt_level" | awk '/level:/ {print $2}')
    batt_temp=$(batt_temp_c)
    cpu_temp=$(asl_cpu_temp_c)

    if [ -n "$batt_level" ]; then
        batt_str="${batt_level}%"
        [ -n "$batt_temp" ] && batt_str="${batt_str} (${batt_temp}°C)"
    else
        batt_str="N/A"
    fi
    cpu_str="${cpu_temp:-N/A}°C"
    up_str=$(asl_uptime)
    svc_up_str=$(asl_svc_uptime)
    freq_str=$(asl_cpu_freq)
    remote_summary=$(asl_remote_summary)

    local max_temp=0 thermal_badge=""
    [ -n "$cpu_temp" ] && [[ "$cpu_temp" =~ ^[0-9]+$ ]] && [ "$cpu_temp" -gt "$max_temp" ] && max_temp=$cpu_temp
    [ -n "$batt_temp" ] && [[ "$batt_temp" =~ ^[0-9]+$ ]] && [ "$batt_temp" -gt "$max_temp" ] && max_temp=$batt_temp

    if [ "$max_temp" -ge 75 ]; then
        thermal_badge="${C_RED}${C_BOLD}[THROTTLED]${C_RESET}"
    elif [ "$max_temp" -ge 60 ]; then
        thermal_badge="${C_YELLOW}${C_BOLD}[WARM]${C_RESET}     "
    else
        thermal_badge="${C_GREEN}${C_BOLD}[COOL]${C_RESET}     "
    fi

    if pgrep -x pulseaudio >/dev/null 2>&1; then audio_status="RUNNING"; else audio_status="STOPPED"; fi

    local chroot_lbl desktop_lbl x11_lbl audio_lbl
    if is_mounted; then chroot_lbl="$(status_badge ACTIVE 8)"; else chroot_lbl="$(status_badge INACTIVE 8)"; fi
    desktop_lbl="$(status_badge "${desktop_status:-STOPPED}" 9)"
    if [ -S "$x11_socket" ]; then x11_lbl="$(status_badge READY 7)"; else x11_lbl="$(status_badge STOPPED 7)"; fi
    audio_lbl="$(status_badge "$audio_status" 9)"

    local boot_status="DISABLED" oom_status="OFF" wdog_status="INACTIVE" wan_ping=""
    [ -f "$HOME/.termux/boot/00-asl-autostart.sh" ] && boot_status="ENABLED"
    if pgrep -f "autoconnect" >/dev/null 2>&1 || asl_is_sshd_running || pgrep -f "asl-watchdog-loop" >/dev/null 2>&1; then
        oom_status="ACTIVE(-1000)"
        wdog_status="RUNNING"
    fi
    wan_ping=$(asl_wan_ping_cached)

    if asl_is_omniroute_running; then
        omni_lbl="$(status_badge ACTIVE 8)"
    else
        omni_lbl="$(status_badge INACTIVE 8)"
    fi

    local boot_lbl="$(status_badge "$boot_status" 9)"
    local wdog_lbl="$(status_badge "$wdog_status" 9)"

    if [ "$mode" = "compact" ]; then
        printf "%s╭─── %sAndroid Subsystem for Linux (ASL)%s %s──────────────────────── v2.5.1 ──%s╮%s\n" "$C_CYAN" "$C_YELLOW$C_BOLD" "$C_CYAN" "$C_SHADOW" "$C_CYAN" "$C_RESET"
        printf "%s│%s  %sChroot:%s %s  %sDesktop:%s %s  %sGPU:%s %s%-25.25s  %s│%s\n" "$C_CYAN" "$C_RESET" "$C_BOLD" "$C_RESET" "$chroot_lbl" "$C_BOLD" "$C_RESET" "$desktop_lbl" "$C_BOLD" "$C_RESET" "$C_YELLOW" "$ASL_GPU_PROFILE" "$C_CYAN" "$C_RESET"
        printf "%s│%s  %sDisplay:%s %s   %sAudio:%s %s  %sGov:%s %s%-26.26s  %s│%s\n" "$C_CYAN" "$C_RESET" "$C_BOLD" "$C_RESET" "$x11_lbl" "$C_BOLD" "$C_RESET" "$audio_lbl" "$C_BOLD" "$C_RESET" "$C_GREEN" "$governor" "$C_CYAN" "$C_RESET"
        printf "%s│%s  %sBattery:%s %s%-12.12s %sCPU:%s %s%-5.5s %s  %sWake-Lock:%s %s%8s  %s│%s\n" "$C_CYAN" "$C_RESET" "$C_BOLD" "$C_RESET" "$C_CYAN" "$batt_str" "$C_BOLD" "$C_RESET" "$C_YELLOW" "$cpu_str" "$thermal_badge" "$C_BOLD" "$C_RESET" "$wlock_lbl" "" "$C_CYAN" "$C_RESET"
        printf "%s│%s  %sHost IP:%s %s%-15.15s  %sWAN:%s %s%-7.7s  %sOmniRoute:%s %s%9s  %s│%s\n" "$C_CYAN" "$C_RESET" "$C_BOLD" "$C_RESET" "$C_CYAN" "$host_ip" "$C_BOLD" "$C_RESET" "$C_CYAN" "$wan_ping" "$C_BOLD" "$C_RESET" "$omni_lbl" "" "$C_CYAN" "$C_RESET"
        printf "%s│%s  %sRAM:%s  [" "$C_CYAN" "$C_RESET" "$C_BOLD" "$C_RESET"
        draw_bar "$mem_pct" 8
        printf "] %3d%%   %sSwap:%s [" "$mem_pct" "$C_BOLD" "$C_RESET"
        draw_bar "$swap_pct" 8
        printf "] %3d%%   %sUptime:%s %s%-12.12s%s  %s│%s\n" "$swap_pct" "$C_BOLD" "$C_RESET" "$C_YELLOW" "$up_str" "$C_RESET" "$C_CYAN" "$C_RESET"
        asl_remote_details
        printf "%s╰────────────────────────────────────────────────────────────────────────╯%s\n" "$C_CYAN" "$C_RESET"
        return 0
    fi

    printf "%s╭─── %sAndroid Subsystem for Linux (ASL)%s %s──────────────────────── v2.5.1 ──%s╮%s\n" "$C_CYAN" "$C_YELLOW$C_BOLD" "$C_CYAN" "$C_SHADOW" "$C_CYAN" "$C_RESET"
    printf "%s│%s  %sChroot:%s %s  %sDesktop:%s %s  %sGPU:%s %s%-25.25s  %s│%s\n" "$C_CYAN" "$C_RESET" "$C_BOLD" "$C_RESET" "$chroot_lbl" "$C_BOLD" "$C_RESET" "$desktop_lbl" "$C_BOLD" "$C_RESET" "$C_YELLOW" "$ASL_GPU_PROFILE" "$C_CYAN" "$C_RESET"
    printf "%s│%s  %sDisplay:%s %s   %sAudio:%s %s  %sGov:%s %s%-26.26s  %s│%s\n" "$C_CYAN" "$C_RESET" "$C_BOLD" "$C_RESET" "$x11_lbl" "$C_BOLD" "$C_RESET" "$audio_lbl" "$C_BOLD" "$C_RESET" "$C_GREEN" "$governor" "$C_CYAN" "$C_RESET"
    printf "%s│%s  %sBattery:%s %s%-12.12s %sCPU:%s %s%-5.5s %s  %sWake-Lock:%s %s%8s  %s│%s\n" "$C_CYAN" "$C_RESET" "$C_BOLD" "$C_RESET" "$C_CYAN" "$batt_str" "$C_BOLD" "$C_RESET" "$C_YELLOW" "$cpu_str" "$thermal_badge" "$C_BOLD" "$C_RESET" "$wlock_lbl" "" "$C_CYAN" "$C_RESET"
    printf "%s│%s  %sHost IP:%s %s%-15.15s  %sWAN:%s %s%-7.7s  %sOmniRoute:%s %s%9s  %s│%s\n" "$C_CYAN" "$C_RESET" "$C_BOLD" "$C_RESET" "$C_CYAN" "$host_ip" "$C_BOLD" "$C_RESET" "$C_CYAN" "$wan_ping" "$C_BOLD" "$C_RESET" "$omni_lbl" "" "$C_CYAN" "$C_RESET"
    printf "%s│%s  %sAutostart:%s %s  %sOOM:%s %s%-13.13s  %sWatchdog:%s %s%7s  %s│%s\n" "$C_CYAN" "$C_RESET" "$C_BOLD" "$C_RESET" "$boot_lbl" "$C_BOLD" "$C_RESET" "$C_GREEN" "$oom_status" "$C_BOLD" "$C_RESET" "$wdog_lbl" "" "$C_CYAN" "$C_RESET"
    printf "%s│%s  %sStorage:%s %s%-22.22s   %sRemote:%s %s%-26.26s  %s│%s\n" "$C_CYAN" "$C_RESET" "$C_BOLD" "$C_RESET" "$C_CYAN" "$disk_data" "$C_BOLD" "$C_RESET" "$C_CYAN" "$remote_summary" "$C_CYAN" "$C_RESET"

    asl_remote_details

    printf "%s├── %sSystem Resource Metrics%s %s─────────────────────────────────────────────%s┤%s\n" "$C_CYAN" "$C_YELLOW$C_BOLD" "$C_CYAN" "$C_SHADOW" "$C_CYAN" "$C_RESET"
    printf "%s│%s  %sRAM:%s  [" "$C_CYAN" "$C_RESET" "$C_BOLD" "$C_RESET"
    draw_bar "$mem_pct" 10
    printf "] %3d%% (%4d/%4d MB)   %sLoad:%s %s%-21.21s  %s│%s\n" "$mem_pct" "$mem_used" "$mem_total" "$C_BOLD" "$C_RESET" "$C_YELLOW" "$load_avg" "$C_CYAN" "$C_RESET"

    local up_field
    up_field=$(printf "%s (Svc %s)" "$up_str" "$svc_up_str")
    printf "%s│%s  %sSwap:%s [" "$C_CYAN" "$C_RESET" "$C_BOLD" "$C_RESET"
    draw_bar "$swap_pct" 10
    printf "] %3d%% (%4d/%4d MB)   %sUptime:%s %s%-20.20s %s│%s\n" "$swap_pct" "$swap_used" "$swap_total" "$C_BOLD" "$C_RESET" "$C_YELLOW" "$up_field" "$C_CYAN" "$C_RESET"
    printf "%s╰────────────────────────────────────────────────────────────────────────╯%s\n" "$C_CYAN" "$C_RESET"
}

is_safe_target_pid() {
    local pid="$1"
    [ -n "$pid" ] && [[ "$pid" =~ ^[0-9]+$ ]] || return 1
    [ "$pid" -le 100 ] && return 1

    local termux_uid proc_uid proc_root
    termux_uid=$(id -u 2>/dev/null || echo "")
    proc_uid=$(asl_exec "awk '/Uid:/ {print \$2}' /proc/$pid/status 2>/dev/null" 2>/dev/null | tr -d '[:space:]')
    proc_root=$(asl_exec "readlink /proc/$pid/root 2>/dev/null" 2>/dev/null | tr -d '[:space:]')

    if [ -n "$termux_uid" ] && [ "$proc_uid" = "$termux_uid" ]; then
        return 0
    fi
    if [ "$proc_root" = "$DEBIANPATH" ]; then
        return 0
    fi
    return 1
}

process_manager() {
    local sort_mode="cpu"
    trap 'printf "\033[?1049l\033[?25h"; trap - INT; return 0 2>/dev/null || exit 0' INT
    printf "\033[?1049h\033[?25l" 2>/dev/null || true
    while true; do
        printf "\033[H\033[J" 2>/dev/null || true
        printf "%s╭─── %sASL Resource & Process Manager%s %s────────────────────────────╮%s\n" "$C_CYAN" "$C_YELLOW$C_BOLD" "$C_CYAN" "$C_SHADOW" "$C_CYAN" "$C_RESET"
        if [ "$sort_mode" = "mem" ]; then
            printf "%s│%s  %sTop Processes by RAM / Memory Usage (%s%s%s):%s                        %s│%s\n" "$C_CYAN" "$C_RESET" "$C_CYAN$C_BOLD" "$C_YELLOW" "sorted by %MEM" "$C_CYAN$C_BOLD" "$C_RESET" "$C_CYAN" "$C_RESET"
        else
            printf "%s│%s  %sTop Processes by CPU Usage (%s%s%s):%s                               %s│%s\n" "$C_CYAN" "$C_RESET" "$C_CYAN$C_BOLD" "$C_YELLOW" "sorted by %CPU" "$C_CYAN$C_BOLD" "$C_RESET" "$C_CYAN" "$C_RESET"
        fi
        printf "%s╰────────────────────────────────────────────────────────────────────────╯%s\n\n" "$C_CYAN" "$C_RESET"
        if [ "$sort_mode" = "mem" ]; then
            asl_exec "ps -eo pid,user,%cpu,%mem,rss,comm --sort=-%mem | head -n 12" 2>/dev/null || ps aux | head -n 12
        else
            asl_exec "ps -eo pid,user,%cpu,%mem,rss,comm --sort=-%cpu | head -n 12" 2>/dev/null || ps aux | head -n 12
        fi
        echo ""
        printf "%s╭── Actions ─────────────────────────────────────────────────────────────╮%s\n" "$C_CYAN" "$C_RESET"
        printf "%s│%s  [1] Refresh  [2] Toggle Sort (CPU <-> RAM)  [3] Terminate  [4] Kill   %s│%s\n" "$C_CYAN" "$C_RESET" "$C_CYAN" "$C_RESET"
        printf "%s│%s  [5] Return to Dashboard                                              %s│%s\n" "$C_CYAN" "$C_RESET" "$C_CYAN" "$C_RESET"
        printf "%s╰────────────────────────────────────────────────────────────────────────╯%s\n\n" "$C_CYAN" "$C_RESET"
        printf "\033[?25h" 2>/dev/null || true
        read -r -p "Select action [1-5]: " pm_act
        case "$pm_act" in
            2)
                if [ "$sort_mode" = "cpu" ]; then sort_mode="mem"; else sort_mode="cpu"; fi
                ;;
            3)
                read -r -p "Enter PID to terminate: " target_pid
                if [[ "$target_pid" =~ ^[0-9]+$ ]]; then
                    if is_safe_target_pid "$target_pid"; then
                        if kill -0 "$target_pid" 2>/dev/null || asl_exec "kill -0 '$target_pid'" 2>/dev/null; then
                            if kill "$target_pid" 2>/dev/null || asl_exec "kill '$target_pid'" 2>/dev/null; then
                                echo "[✓] Sent SIGTERM to PID $target_pid"
                            else
                                echo "[!] Failed to terminate PID $target_pid"
                            fi
                        else
                            echo "[!] Process PID $target_pid no longer exists."
                        fi
                    else
                        echo "[!] Refused: PID $target_pid is a system process outside ASL/Termux."
                    fi
                else
                    echo "[!] Invalid PID format."
                fi
                pause_dashboard
                ;;
            4)
                read -r -p "Enter PID to force kill: " target_pid
                if [[ "$target_pid" =~ ^[0-9]+$ ]]; then
                    if is_safe_target_pid "$target_pid"; then
                        if kill -0 "$target_pid" 2>/dev/null || asl_exec "kill -0 '$target_pid'" 2>/dev/null; then
                            if kill -9 "$target_pid" 2>/dev/null || asl_exec "kill -9 '$target_pid'" 2>/dev/null; then
                                echo "[✓] Sent SIGKILL to PID $target_pid"
                            else
                                echo "[!] Failed to kill PID $target_pid"
                            fi
                        else
                            echo "[!] Process PID $target_pid no longer exists."
                        fi
                    else
                        echo "[!] Refused: PID $target_pid is a system process outside ASL/Termux."
                    fi
                else
                    echo "[!] Invalid PID format."
                fi
                pause_dashboard
                ;;
            1) continue ;;
            5|*) break ;;
        esac
    done
    printf "\033[?1049l\033[?25h" 2>/dev/null || true
    trap - INT
}

watch_dashboard() {
    trap 'printf "\033[?1049l\033[?25h"; trap - INT; return 0 2>/dev/null || exit 0' INT
    printf "\033[?1049h\033[?25l" 2>/dev/null || true
    while true; do
        printf "\033[H\033[J" 2>/dev/null || true
        overview compact
        echo ""
        printf '%sTop Processes by CPU Usage%s\n' "$C_CYAN$C_BOLD" "$C_RESET"
        printf '%s%-7s %-8s %7s %6s  %s%s\n' "$C_DIM" "PID" "USER" "%CPU" "%MEM" "COMMAND" "$C_RESET"
        asl_exec "ps -eo pid,user,%cpu,%mem,comm --sort=-%cpu | head -n 9 | tail -n +2" 2>/dev/null || ps aux | head -n 9 | tail -n +2 || true
        echo ""
        printf '%s[LIVE MONITOR - %s] Host Up %s (Svc %s) | Press "q" or Ctrl+C to return%s\n' "$C_CYAN$C_BOLD" "$(date '+%H:%M:%S' 2>/dev/null || echo '?')" "$(asl_uptime)" "$(asl_svc_uptime)" "$C_RESET"
        read -rsn1 -t 1.5 key 2>/dev/null || true
        if [ "$key" = "q" ] || [ "$key" = "Q" ] || [ "$key" = $'\x1b' ]; then
            break
        fi
    done
    printf "\033[?1049l\033[?25h" 2>/dev/null || true
    trap - INT
}

show_host_apps_menu() {
    bash "$REAL_SCRIPT" game menu
}

dashboard() {
    local C_SHADOW=$'\033[90m'
    local sel=1
    local choice=""
    local overview_cache=""
    local need_refresh=1

    cleanup_tui() {
        stty echo icanon 2>/dev/null || true
        printf "\033[?1049l\033[?25h" 2>/dev/null || true
    }

    # Trap Ctrl+C (SIGINT) to cleanly exit to Termux prompt
    trap 'cleanup_tui; printf "\n\033[1;32m[✓]\033[0m Exited ASL Dashboard.\n"; trap - INT; return 0 2>/dev/null || exit 0' INT

    # Switch to DEC 1049 Alternate Screen Buffer (prevents scrollback history repetition)
    printf "\033[?1049h\033[?25l" 2>/dev/null || true

    render_opt() {
        local idx="$1"
        local hk="$2"
        local label="$3"
        local current_sel="$4"
        local plain_str="" padded="" colored=""

        if [ -n "$hk" ]; then
            plain_str=$(printf "%2d. [%s] %s" "$idx" "$hk" "$label")
        else
            plain_str=$(printf "%2d.     %s" "$idx" "$label")
        fi

        padded=$(printf "%-30.30s" "$plain_str")

        if [ "$idx" -eq "$current_sel" ]; then
            printf "%s│\033[1;30;46m ▶ %-30.30s \033[0m%s│%s" "$C_CYAN" "$plain_str" "$C_CYAN" "$C_RESET"
        else
            if [ -n "$hk" ]; then
                colored="${padded/\[$hk\]/${C_YELLOW}[${hk}]${C_RESET}}"
                printf "%s│%s  %s  %s│%s" "$C_CYAN" "$C_RESET" "$colored" "$C_CYAN" "$C_RESET"
            else
                printf "%s│%s  %s  %s│%s" "$C_CYAN" "$C_RESET" "$padded" "$C_CYAN" "$C_RESET"
            fi
        fi
    }

    render_frame() {
        printf "\033[?1049h\033[?25l\033[H\033[J" 2>/dev/null || true
        echo "$overview_cache"
        echo ""
        printf "%s╭── Linux Chroot ──────────────────╮%s  %s╭── Desktop & Remote ──────────────╮%s\n" "$C_CYAN" "$C_RESET" "$C_CYAN" "$C_RESET"
        render_opt 1 "s" "Start / Mount Chroot" "$sel"; printf "  "; render_opt 7 "d" "Start XFCE4 Desktop" "$sel"; echo ""
        render_opt 2 "x" "Stop & Unmount Chroot" "$sel"; printf "  "; render_opt 8 "" "Desktop Status / Stop" "$sel"; echo ""
        render_opt 3 "" "Open Root Shell" "$sel"; printf "  "; render_opt 9 "" "Theme & Resolution" "$sel"; echo ""
        render_opt 4 "" "Run Single Command" "$sel"; printf "  "; render_opt 10 "v" "Remote Access Manager" "$sel"; echo ""
        render_opt 5 "" "Snapshots & Backups" "$sel"; printf "  "; render_opt 11 "" "PulseAudio Control" "$sel"; echo ""
        render_opt 6 "a" "Android AID Groups" "$sel"; printf "  "; render_opt 12 "" "Sync Debian Launchers" "$sel"; echo ""
        printf "%s╰──────────────────────────────────╯%s  %s╰──────────────────────────────────╯%s\n" "$C_CYAN" "$C_RESET" "$C_CYAN" "$C_RESET"
        printf "%s╭── Gaming Engine ─────────────────╮%s  %s╭── Android Bridge ────────────────╮%s\n" "$C_CYAN" "$C_RESET" "$C_CYAN" "$C_RESET"
        render_opt 13 "g" "Run Windows .exe" "$sel"; printf "  "; render_opt 17 "k" "CPU Wake Lock Toggle" "$sel"; echo ""
        render_opt 14 "m" "Performance Profile" "$sel"; printf "  "; render_opt 18 "o" "Open File in Host App" "$sel"; echo ""
        render_opt 15 "" "Setup Wine / Box64" "$sel"; printf "  "; render_opt 19 "c" "System Clipboard Sync" "$sel"; echo ""
        render_opt 16 "" "MangoHud & Gamepad" "$sel"; printf "  "; render_opt 20 "n" "Notification / Toast" "$sel"; echo ""
        printf "%s╰──────────────────────────────────╯%s  %s╰──────────────────────────────────╯%s\n" "$C_CYAN" "$C_RESET" "$C_CYAN" "$C_RESET"
        printf "%s╭── Diagnostics & System ──────────╮%s  %s╭── AI & Service Hub ──────────────╮%s\n" "$C_CYAN" "$C_RESET" "$C_CYAN" "$C_RESET"
        render_opt 21 "p" "Resource Manager" "$sel"; printf "  "; render_opt 25 "" "Host Apps Launcher" "$sel"; echo ""
        render_opt 22 "t" "Thermal Monitor" "$sel"; printf "  "; render_opt 26 "z" "Guided Setup Wizard" "$sel"; echo ""
        render_opt 23 "" "Environment Doctor" "$sel"; printf "  "; render_opt 27 "i" "OmniRoute AI Proxy" "$sel"; echo ""
        render_opt 24 "" "GPU Hardware Profile" "$sel"; printf "  "; render_opt 28 "b" "24/7 Service Manager" "$sel"; echo ""
        printf "%s╰──────────────────────────────────╯%s  %s╰──────────────────────────────────╯%s\n" "$C_CYAN" "$C_RESET" "$C_CYAN" "$C_RESET"
        printf "%s╭────────────────────────────────────────────────────────────────────────╮%s\n" "$C_CYAN" "$C_RESET"
        printf "%s│%s  %s[h]%s Help  %s[r]%s Refresh  %s[w]%s Watch  %s[q]%s Exit  %s[↑↓←→]%s Move  %s[↵]%s Select   %s│%s\n" \
            "$C_CYAN" "$C_RESET" "$C_YELLOW" "$C_RESET" "$C_YELLOW" "$C_RESET" "$C_YELLOW" "$C_RESET" "$C_YELLOW" "$C_RESET" "$C_CYAN" "$C_RESET" "$C_GREEN" "$C_RESET" "$C_CYAN" "$C_RESET"
        printf "%s╰────────────────────────────────────────────────────────────────────────╯%s\n" "$C_CYAN" "$C_RESET"
        printf "\033[J\033[?25h" 2>/dev/null || true
    }

    while true; do
        if [ "$need_refresh" -eq 1 ] || [ -z "$overview_cache" ]; then
            overview_cache=$(overview compact 2>/dev/null || true)
            need_refresh=0
        fi

        render_frame

        choice=""
        if [ ! -t 0 ]; then
            read -r choice || { cleanup_tui; return 0; }
        else
            key=""
            if read -rsn1 -t 1.5 raw_key 2>/dev/null; then
                if [ "$raw_key" = $'\x1b' ]; then
                    read -rsn1 -t 0.05 esc1 2>/dev/null || esc1=""
                    read -rsn1 -t 0.05 esc2 2>/dev/null || esc2=""
                    case "$esc1$esc2" in
                        "[A") key="UP" ;;
                        "[B") key="DOWN" ;;
                        "[C") key="RIGHT" ;;
                        "[D") key="LEFT" ;;
                        *) key="ESC" ;;
                    esac
                elif [ "$raw_key" = "" ]; then
                    key="ENTER"
                else
                    key="$raw_key"
                fi
            else
                key="IDLE_TICK"
            fi

            case "$key" in
                IDLE_TICK)
                    need_refresh=1
                    continue
                    ;;
                UP)
                    case "$sel" in
                        2|3|4|5|6) sel=$(( sel - 1 )) ;;
                        1) sel=24 ;;
                        8|9|10|11|12) sel=$(( sel - 1 )) ;;
                        7) sel=28 ;;
                        14|15|16) sel=$(( sel - 1 )) ;;
                        13) sel=6 ;;
                        18|19|20) sel=$(( sel - 1 )) ;;
                        17) sel=12 ;;
                        22|23|24) sel=$(( sel - 1 )) ;;
                        21) sel=16 ;;
                        26|27|28) sel=$(( sel - 1 )) ;;
                        25) sel=20 ;;
                        *) sel=1 ;;
                    esac
                    continue
                    ;;
                DOWN)
                    case "$sel" in
                        1|2|3|4|5) sel=$(( sel + 1 )) ;;
                        6) sel=13 ;;
                        7|8|9|10|11) sel=$(( sel + 1 )) ;;
                        12) sel=17 ;;
                        13|14|15) sel=$(( sel + 1 )) ;;
                        16) sel=21 ;;
                        17|18|19) sel=$(( sel + 1 )) ;;
                        20) sel=25 ;;
                        21|22|23) sel=$(( sel + 1 )) ;;
                        24) sel=1 ;;
                        25|26|27) sel=$(( sel + 1 )) ;;
                        28) sel=7 ;;
                        *) sel=1 ;;
                    esac
                    continue
                    ;;
                LEFT|RIGHT)
                    case "$sel" in
                        1|2|3|4|5|6) sel=$(( sel + 6 )) ;;
                        7|8|9|10|11|12) sel=$(( sel - 6 )) ;;
                        13|14|15|16) sel=$(( sel + 4 )) ;;
                        17|18|19|20) sel=$(( sel - 4 )) ;;
                        21|22|23|24) sel=$(( sel + 4 )) ;;
                        25|26|27|28) sel=$(( sel - 4 )) ;;
                        *) sel=1 ;;
                    esac
                    continue
                    ;;
                ENTER)
                    choice="$sel"
                    need_refresh=1
                    ;;
                1|2)
                    read -rsn1 -t 0.15 sub_digit 2>/dev/null || sub_digit=""
                    if [[ "$sub_digit" =~ [0-9] ]]; then
                        choice="${key}${sub_digit}"
                    else
                        choice="$key"
                    fi
                    need_refresh=1
                    ;;
                3|4|5|6|7|8|9)
                    choice="$key"
                    need_refresh=1
                    ;;
                s|S) choice="1"; need_refresh=1 ;;
                x|X) choice="2"; need_refresh=1 ;;
                a|A) choice="6"; need_refresh=1 ;;
                d|D) choice="7"; need_refresh=1 ;;
                v|V) choice="10"; need_refresh=1 ;;
                g|G) choice="13"; need_refresh=1 ;;
                m|M) choice="14"; need_refresh=1 ;;
                k|K) choice="17"; need_refresh=1 ;;
                o|O) choice="18"; need_refresh=1 ;;
                c|C) choice="19"; need_refresh=1 ;;
                n|N) choice="20"; need_refresh=1 ;;
                p|P) choice="21"; need_refresh=1 ;;
                t|T) choice="22"; need_refresh=1 ;;
                z|Z) choice="26"; need_refresh=1 ;;
                i|I) choice="27"; need_refresh=1 ;;
                b|B) choice="28"; need_refresh=1 ;;
                h|H)
                    printf "\033[?1049l\033[?25h" 2>/dev/null || true
                    show_help
                    pause_dashboard
                    need_refresh=1
                    continue
                    ;;
                r|R) need_refresh=1; continue ;;
                w|W)
                    watch_dashboard
                    need_refresh=1
                    continue
                    ;;
                q|Q)
                    trap - INT
                    cleanup_tui
                    printf "\033[1;32m[✓]\033[0m Exited ASL Dashboard.\n"
                    return 0 2>/dev/null || exit 0
                    ;;
                *)
                    choice="$key"
                    need_refresh=1
                    ;;
            esac
        fi

        # Switch to primary buffer for running sub-commands
        printf "\033[?1049l\033[?25h" 2>/dev/null || true

        case "$choice" in
            1|s|S) bash "$REAL_SCRIPT" start; pause_dashboard ;;
            2|x|X)
                if confirm_action "Stop all chroot processes and unmount Debian?"; then bash "$REAL_SCRIPT" stop; fi
                pause_dashboard ;;
            3) bash "$REAL_SCRIPT" shell ;;
            4)
                read -r -p "Debian command: " command
                if [ -n "$command" ]; then bash "$REAL_SCRIPT" exec "$command"; fi
                pause_dashboard ;;
            5)
                echo "Snapshot actions: 1) list  2) create  3) restore  4) delete  5) backup (tar.gz)  6) restore archive"
                read -r -p "Select action [1-6]: " s_act
                case "$s_act" in
                    1) bash "$REAL_SCRIPT" snapshot list ;;
                    2) read -r -p "Snapshot name: " s_name; bash "$REAL_SCRIPT" snapshot create "$s_name" ;;
                    3) read -r -p "Snapshot name to restore: " s_name; bash "$REAL_SCRIPT" snapshot restore "$s_name" ;;
                    4) read -r -p "Snapshot name to delete: " s_name; bash "$REAL_SCRIPT" snapshot delete "$s_name" ;;
                    5) bash "$REAL_SCRIPT" backup ;;
                    6) read -r -p "Backup tar.gz file path to restore: " r_file; bash "$REAL_SCRIPT" restore "$r_file" ;;
                esac
                pause_dashboard ;;
            6|a|A) bash "$REAL_SCRIPT" aid setup; pause_dashboard ;;
            7|d|D) bash "$REAL_SCRIPT" desktop start; pause_dashboard ;;
            8)
                echo "Desktop actions: 1) status  2) restart  3) stop  4) force-stop"
                read -r -p "Select action [1-4]: " d_act
                case "$d_act" in
                    2) bash "$REAL_SCRIPT" desktop restart ;;
                    3) bash "$REAL_SCRIPT" desktop stop ;;
                    4) bash "$REAL_SCRIPT" desktop force-stop ;;
                    *) bash "$REAL_SCRIPT" desktop status ;;
                esac
                pause_dashboard ;;
            9)
                echo "Appearance options: 1) Theme preset  2) Termux:X11 Resolution"
                read -r -p "Select option [1-2]: " app_act
                case "$app_act" in
                    1)
                        echo "Presets: tokyonight, aesthetic, graphite, habiboow, dark, light, nord, dracula, greybird"
                        read -r -p "Theme name: " t_preset
                        [ -n "$t_preset" ] && bash "$REAL_SCRIPT" theme "$t_preset"
                        ;;
                    2)
                        echo "Presets: 720p, 1080p, native"
                        read -r -p "Resolution preset: " r_preset
                        [ -n "$r_preset" ] && bash "$REAL_SCRIPT" resolution "$r_preset"
                        ;;
                esac
                pause_dashboard ;;
            10|v|V)
                echo "Remote Manager:"
                echo "  1) Start All Tunnels (Oracle + Serveo + Ngrok + LAN + AutoConnect)"
                echo "  2) Oracle VPS Tunnel Start / Stop / Status"
                echo "  3) Serveo Tunnel Start / Stop"
                echo "  4) Ngrok Tunnel Start / Stop"
                echo "  5) Manage Ngrok Auth Tokens (Add / List / Reset)"
                echo "  6) Show Remote VNC / Desktop Tunnel Instructions"
                echo "  7) LAN SSH Server Start / Stop"
                echo "  8) Auto-Connect Daemon Start / Stop"
                echo "  9) Configure Remote SSH Password (optional)"
                echo " 10) Show Connection Info & Status"
                read -r -p "Select action [1-10]: " r_act
                case "$r_act" in
                    1) bash "$REAL_SCRIPT" remote all ;;
                    2)
                        echo "Oracle VPS: 1) Start  2) Stop  3) Status"
                        read -r -p "Choice: " o_choice
                        case "$o_choice" in
                            1) bash "$REAL_SCRIPT" remote oracle start ;;
                            2) bash "$REAL_SCRIPT" remote oracle stop ;;
                            *) bash "$REAL_SCRIPT" remote oracle status ;;
                        esac
                        ;;
                    3)
                        echo "Serveo: 1) Start  2) Stop  3) Set Custom Alias  4) Status"
                        read -r -p "Choice: " s_choice
                        case "$s_choice" in
                            1) bash "$REAL_SCRIPT" remote serveo start ;;
                            2) bash "$REAL_SCRIPT" remote serveo stop ;;
                            3)
                                read -r -p "Enter custom Serveo alias: " s_alias_val
                                [ -n "$s_alias_val" ] && bash "$REAL_SCRIPT" remote serveo alias "$s_alias_val"
                                ;;
                            *) bash "$REAL_SCRIPT" remote serveo status ;;
                        esac
                        ;;
                    4)
                        echo "Ngrok: 1) Start  2) Stop  3) Rotate Token  4) Status"
                        read -r -p "Choice: " n_choice
                        case "$n_choice" in
                            1) bash "$REAL_SCRIPT" remote ngrok start ;;
                            2) bash "$REAL_SCRIPT" remote ngrok stop ;;
                            3) bash "$REAL_SCRIPT" remote ngrok rotate ;;
                            *) bash "$REAL_SCRIPT" remote ngrok status ;;
                        esac
                        ;;
                    5)
                        echo "Ngrok Tokens: 1) Add Token  2) List Pool  3) Reset Exhausted Status"
                        read -r -p "Choice: " nt_choice
                        case "$nt_choice" in
                            1)
                                read -r -p "Enter Ngrok Auth Token: " ng_token
                                [ -n "$ng_token" ] && bash "$REAL_SCRIPT" remote ngrok add-token "$ng_token"
                                ;;
                            2) bash "$REAL_SCRIPT" remote ngrok list-tokens ;;
                            3) bash "$REAL_SCRIPT" remote ngrok reset ;;
                        esac
                        ;;
                    6)
                        bash "$REAL_SCRIPT" remote gui
                        ;;
                    7)
                        echo "LAN SSH: 1) Start  2) Stop  3) Status"
                        read -r -p "Choice: " l_choice
                        case "$l_choice" in
                            1) bash "$REAL_SCRIPT" remote lan start ;;
                            2) bash "$REAL_SCRIPT" remote lan stop ;;
                            *) bash "$REAL_SCRIPT" remote lan status ;;
                        esac
                        ;;
                    8)
                        echo "Auto-Connect Daemon: 1) Start  2) Stop  3) Status"
                        read -r -p "Choice: " ac_choice
                        case "$ac_choice" in
                            1) bash "$REAL_SCRIPT" remote autoconnect start ;;
                            2) bash "$REAL_SCRIPT" remote autoconnect stop ;;
                            *) bash "$REAL_SCRIPT" remote autoconnect status ;;
                        esac
                        ;;
                    9)
                        read -r -p "Enter new SSH Remote Password (or 'clear' to remove): " new_ssh_pass
                        if [ "$new_ssh_pass" = "clear" ]; then
                            bash "$REAL_SCRIPT" remote password clear
                        elif [ -n "$new_ssh_pass" ]; then
                            bash "$REAL_SCRIPT" remote password set "$new_ssh_pass"
                        fi
                        ;;
                    *) bash "$REAL_SCRIPT" remote status ;;
                esac
                pause_dashboard ;;
            11)
                echo "PulseAudio actions: 1) status  2) start  3) stop  4) test tone  5) set volume"
                read -r -p "Select action [1-5]: " au_act
                case "$au_act" in
                    2) bash "$REAL_SCRIPT" audio start ;;
                    3) bash "$REAL_SCRIPT" audio stop ;;
                    4) bash "$REAL_SCRIPT" audio test ;;
                    5) read -r -p "Master volume percentage (0-100): " vol_val; [ -n "$vol_val" ] && bash "$REAL_SCRIPT" audio volume "$vol_val" ;;
                    *) bash "$REAL_SCRIPT" audio status ;;
                esac
                pause_dashboard ;;
            12) bash "$REAL_SCRIPT" desktop sync-apps; pause_dashboard ;;
            13|g|G)
                echo "Gaming actions: 1) Run .exe  2) Wine Explorer  3) Wine File Manager  4) Winecfg  5) Winetricks  6) Setup Gaming Layer"
                read -r -p "Select action [1-6]: " g_act
                case "$g_act" in
                    2) bash "$REAL_SCRIPT" game desktop ;;
                    3) bash "$REAL_SCRIPT" game winefile ;;
                    4) bash "$REAL_SCRIPT" game winecfg ;;
                    5) bash "$REAL_SCRIPT" game winetricks ;;
                    6) bash "$REAL_SCRIPT" setup-gaming ;;
                    *)
                        read -r -p "Full path to Windows .exe (or leave empty for GUI file picker): " exe_path
                        if [ -n "$exe_path" ]; then
                            bash "$REAL_SCRIPT" game run "$exe_path"
                        else
                            bash "$REAL_SCRIPT" game picker
                        fi
                        ;;
                esac
                pause_dashboard ;;
            14|m|M)
                echo "Performance Profile: 1) gaming  2) performance  3) balanced  4) status"
                read -r -p "Select mode [1-4]: " m_act
                case "$m_act" in
                    1) bash "$REAL_SCRIPT" mode gaming ;;
                    2) bash "$REAL_SCRIPT" mode performance ;;
                    3) bash "$REAL_SCRIPT" mode balanced ;;
                    *) bash "$REAL_SCRIPT" mode status ;;
                esac
                pause_dashboard ;;
            15) bash "$REAL_SCRIPT" setup-gaming; pause_dashboard ;;
            16)
                echo "Gaming Overlay & Input: 1) MangoHud HUD toggle  2) Gamepad / Joystick status & test"
                read -r -p "Select option [1-2]: " g_opt
                case "$g_opt" in
                    1)
                        echo "MangoHud: 1) Toggle  2) On  3) Off  4) Status"
                        read -r -p "Choice: " hud_c
                        case "$hud_c" in
                            1) bash "$REAL_SCRIPT" hud toggle ;;
                            2) bash "$REAL_SCRIPT" hud on ;;
                            3) bash "$REAL_SCRIPT" hud off ;;
                            *) bash "$REAL_SCRIPT" hud status ;;
                        esac
                        ;;
                    2)
                        echo "Gamepad: 1) Status  2) Sync bluetooth evdev  3) Input test"
                        read -r -p "Choice: " gp_c
                        case "$gp_c" in
                            2) bash "$REAL_SCRIPT" gamepad sync ;;
                            3) bash "$REAL_SCRIPT" gamepad test ;;
                            *) bash "$REAL_SCRIPT" gamepad status ;;
                        esac
                        ;;
                esac
                pause_dashboard ;;
            17|k|K)
                echo "Wake lock actions: 1) status  2) enable (on)  3) disable (off)"
                read -r -p "Select action [1-3]: " w_act
                case "$w_act" in
                    2) bash "$REAL_SCRIPT" wakelock on ;;
                    3) bash "$REAL_SCRIPT" wakelock off ;;
                    *) bash "$REAL_SCRIPT" wakelock status ;;
                esac
                pause_dashboard ;;
            18|o|O)
                read -r -p "Enter file path or URL to open in Android host: " target_open
                if [ -n "$target_open" ]; then bash "$REAL_SCRIPT" open "$target_open"; fi
                pause_dashboard ;;
            19|c|C)
                echo "Clipboard actions: 1) paste (read)  2) copy (write)"
                read -r -p "Select action [1-2]: " c_act
                case "$c_act" in
                    2) read -r -p "Text to copy to clipboard: " c_text; bash "$REAL_SCRIPT" clip copy "$c_text" ;;
                    *) bash "$REAL_SCRIPT" clip paste ;;
                esac
                pause_dashboard ;;
            20|n|N)
                echo "Notification actions: 1) Toast popup  2) Banner notification"
                read -r -p "Select action [1-2]: " n_act
                case "$n_act" in
                    2)
                        read -r -p "Notification title: " n_title
                        read -r -p "Notification content: " n_text
                        if [ -n "$n_text" ]; then bash "$REAL_SCRIPT" notify "${n_title:-ASL}" "$n_text"; fi
                        ;;
                    *)
                        read -r -p "Toast message text: " n_text
                        if [ -n "$n_text" ]; then bash "$REAL_SCRIPT" toast "$n_text"; fi
                        ;;
                esac
                pause_dashboard ;;
            21|p|P) process_manager ;;
            22|t|T) bash "$REAL_SCRIPT" thermal; pause_dashboard ;;
            23) bash "$REAL_SCRIPT" doctor; pause_dashboard ;;
            24) bash "$REAL_SCRIPT" gpu; pause_dashboard ;;
            25|apps|host) show_host_apps_menu ;;
            26|z|Z|wizard|init) bash "$REAL_SCRIPT" wizard; pause_dashboard ;;
            27|i|I)
                echo "OmniRoute Local AI Proxy (Port 20128):"
                echo "  1) Start OmniRoute Daemon (as Root)"
                echo "  2) Stop OmniRoute"
                echo "  3) Restart OmniRoute"
                echo "  4) OmniRoute Status & Port Check"
                echo "  5) View OmniRoute Live Log"
                read -r -p "Select action [1-5]: " omni_act
                case "$omni_act" in
                    1)
                        if [ -x "$HOME/omniroute-daemon.sh" ]; then
                            echo "[*] Starting OmniRoute AI proxy as root..."
                            su -c "/data/data/com.termux/files/usr/bin/bash /data/data/com.termux/files/home/omniroute-daemon.sh" >> /data/data/com.termux/files/home/omniroute.log 2>&1 &
                            sleep 1
                            if (timeout 1 bash -c 'cat < /dev/null > /dev/tcp/127.0.0.1/20128') 2>/dev/null || pgrep -f "omniroute" >/dev/null 2>&1 || su -c "pgrep -f omniroute" >/dev/null 2>&1; then
                                echo "[✓] OmniRoute is ACTIVE on http://127.0.0.1:20128"
                            else
                                echo "[!] Notice: Starting in background. Check logs."
                            fi
                        else
                            echo "[!] Error: $HOME/omniroute-daemon.sh not found."
                        fi
                        ;;
                    2)
                        echo "[*] Stopping OmniRoute daemon..."
                        pkill -f "omniroute" 2>/dev/null || true
                        su -c "pkill -f omniroute" 2>/dev/null || true
                        echo "[✓] OmniRoute stopped."
                        ;;
                    3)
                        echo "[*] Restarting OmniRoute daemon..."
                        pkill -f "omniroute" 2>/dev/null || true
                        su -c "pkill -f omniroute" 2>/dev/null || true
                        sleep 1
                        if [ -x "$HOME/omniroute-daemon.sh" ]; then
                            su -c "/data/data/com.termux/files/usr/bin/bash /data/data/com.termux/files/home/omniroute-daemon.sh" >> /data/data/com.termux/files/home/omniroute.log 2>&1 &
                            echo "[✓] OmniRoute restarted."
                        fi
                        ;;
                    4)
                        echo "=== OmniRoute Local AI Proxy Status ==="
                        if asl_is_omniroute_running; then
                            echo " Status:  ACTIVE"
                            echo " Port:    127.0.0.1:20128 (REST / SSE / OpenAI API / Anthropic API)"
                            local opid
                            opid=$(pgrep -f "omniroute" 2>/dev/null | head -n 1 || true)
                            [ -z "$opid" ] && opid=$(su -c "pgrep -f omniroute 2>/dev/null | head -n 1" 2>/dev/null || true)
                            echo " PID:     ${opid:-active}"
                        else
                            echo " Status:  INACTIVE"
                            echo " Port:    127.0.0.1:20128 (Unbound)"
                        fi
                        ;;
                    5)
                        if [ -f "$HOME/omniroute.log" ]; then
                            echo "=== Last 25 lines of $HOME/omniroute.log ==="
                            tail -n 25 "$HOME/omniroute.log"
                        else
                            echo "[!] No log file found at $HOME/omniroute.log"
                        fi
                        ;;
                esac
                pause_dashboard ;;
            28|b|B)
                echo "ASL 24/7 Service Manager & Boot Autostart:"
                echo "  1) Start All 24/7 Services"
                echo "  2) Stop All Services"
                echo "  3) Restart All Services"
                echo "  4) Run Watchdog Service Health Check"
                echo "  5) Start Autonomous Background Watchdog Loop (180s)"
                echo "  6) Enable Boot Autostart (Termux:Boot & Shell Hook)"
                echo "  7) Disable Boot Autostart"
                echo "  8) Show 24/7 Service Status & Uptime"
                read -r -p "Select action [1-8]: " svc_act
                case "$svc_act" in
                    1) bash "$REAL_SCRIPT" service start ;;
                    2) bash "$REAL_SCRIPT" service stop ;;
                    3) bash "$REAL_SCRIPT" service restart ;;
                    4) bash "$REAL_SCRIPT" service check ;;
                    5) bash "$REAL_SCRIPT" service loop ;;
                    6) bash "$REAL_SCRIPT" service enable ;;
                    7) bash "$REAL_SCRIPT" service disable ;;
                    *) bash "$REAL_SCRIPT" service status ;;
                esac
                pause_dashboard ;;
            h|H) show_help; pause_dashboard ;;
            r|R|"") ;;
            w|W) watch_dashboard ;;
            q|Q) return 0 ;;
            *) echo "Invalid option: ${choice:-empty}"; pause_dashboard ;;
        esac
    done
}

case "${1:-}" in
    exec-mode|execmode)
        shift
        subaction="${1:-status}"
        case "$subaction" in
            root)
                mkdir -p "$PREFIX/etc"
                echo "root" > "$PREFIX/etc/asl_exec_mode"
                echo "[✓] ASL execution mode set to: ROOT (su kernel chroot)"
                ;;
            shizuku)
                mkdir -p "$PREFIX/etc"
                echo "shizuku" > "$PREFIX/etc/asl_exec_mode"
                echo "[✓] ASL execution mode set to: SHIZUKU (rish ADB privileged mode)"
                ;;
            proot)
                mkdir -p "$PREFIX/etc"
                echo "proot" > "$PREFIX/etc/asl_exec_mode"
                echo "[✓] ASL execution mode set to: PROOT (user-space emulation)"
                ;;
            status|*)
                active_mode=$(cat "$PREFIX/etc/asl_exec_mode" 2>/dev/null || echo "auto")
                echo "ASL Execution Mode: ${active_mode:-auto} (Active runtime: ${ASL_EXEC_MODE:-proot})"
                echo "Usage: asl exec-mode [root|shizuku|proot|status]"
                ;;
        esac
        ;;
    dashboard|dash|menu|ui)
        dashboard
        ;;
    wizard|init|setup-wizard)
        shift
        bash "$ASL_DIR/core/wizard.sh" "$@"
        ;;
    overview)
        shift
        overview "$@"
        ;;
    watch|monitor)
        watch_dashboard
        ;;
    ps|top|processes)
        process_manager
        ;;
    start)
        asl_with_lock bash "$ASL_DIR/core/mount-chroot.sh" || exit 1
        ;;
    stop)
        if ! confirm_action "Stop desktop and unmount the Debian chroot?"; then
            echo "[*] Cancelled."
            exit 0
        fi
        asl_with_lock bash "$ASL_DIR/desktop/start-desktop.sh" stop \
            || echo "[!] Desktop shutdown reported an error; continuing to unmount chroot."
        asl_with_lock bash "$ASL_DIR/core/stop-chroot.sh"
        ;;
    doctor)
        bash "$ASL_DIR/core/doctor.sh"
        ;;
    status)
        echo "=== ASL Status ==="
        if is_mounted; then
            echo " Status:   ACTIVE (Mounted)"
        else
            echo " Status:   INACTIVE (Unmounted)"
        fi
        echo " Location: $DEBIANPATH"
        echo " Mode:     ${ASL_EXEC_MODE:-root}"
        SIZE=$(asl_exec "du -shx '$DEBIANPATH' 2>/dev/null | cut -f1" 2>/dev/null || du -shx "$DEBIANPATH" 2>/dev/null | cut -f1)
        echo " Size:     ${SIZE:-Unknown}"

        if is_mounted; then
            echo ""
            echo "Active Sub-mounts:"
            asl_exec "grep '$DEBIANPATH' /proc/mounts | awk '{print \" - \" \$2 \" (\" \$3 \")\"}'" 2>/dev/null || true
        fi
        ;;
    shell|enter)
        shift
        TARGET_USER="${1:-root}"
        ensure_mounted
        case "${ASL_EXEC_MODE:-root}" in
            shizuku)
                if rish -c "id" >/dev/null 2>&1; then
                    exec rish -c "chroot '$DEBIANPATH' /bin/bash --login"
                else
                    exec proot-distro login asl-debian -- /bin/bash --login
                fi
                ;;
            proot)
                exec proot-distro login asl-debian -- /bin/bash --login
                ;;
            root|*)
                if [ "$TARGET_USER" = "root" ]; then
                    exec su -c "chroot '$DEBIANPATH' /usr/bin/env -i HOME=/root USER=root LOGNAME=root PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin TERM=${TERM:-xterm-256color} LANG=C.UTF-8 LC_ALL=C.UTF-8 TMPDIR=/tmp /bin/bash --login"
                fi
                if [[ ! "$TARGET_USER" =~ ^[a-z_][a-z0-9_-]*$ ]]; then
                    echo "Error: Invalid Debian username."
                    exit 1
                fi
                if ! su -c "chroot '$DEBIANPATH' id '$TARGET_USER'" >/dev/null 2>&1; then
                    echo "Error: User '$TARGET_USER' does not exist in Debian chroot."
                    exit 1
                fi
                exec su -c "chroot '$DEBIANPATH' /usr/bin/env -i HOME=/home/$TARGET_USER USER=$TARGET_USER LOGNAME=$TARGET_USER PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin TERM=${TERM:-xterm-256color} LANG=C.UTF-8 LC_ALL=C.UTF-8 TMPDIR=/tmp /bin/su -l '$TARGET_USER'"
                ;;
        esac
        ;;
    exec|run)
        shift
        if [ $# -eq 0 ]; then
            echo "Error: No command specified. Usage: asl exec <command>"
            exit 1
        fi
        ensure_mounted
        run_in_chroot "$@"
        ;;
    dxvk)
        shift
        ensure_mounted
        bash "$ASL_DIR/gaming/wine-box64.sh" dxvk "$@"
        ;;
    game|wine)
        shift
        ensure_mounted
        bash "$ASL_DIR/gaming/wine-box64.sh" "$@"
        ;;
    setup-gaming|setup)
        ensure_mounted
        bash "$ASL_DIR/gaming/wine-box64.sh" setup
        ;;
    benchmark|bench)
        ensure_mounted
        bash "$ASL_DIR/gaming/wine-box64.sh" benchmark
        ;;
    gpu)
        bash "$ASL_DIR/core/gpu-detect.sh"
        ;;
    thermal|temp)
        bash "$ASL_DIR/core/thermal.sh"
        ;;
    theme)
        shift
        bash "$ASL_DIR/desktop/theme.sh" "$@"
        ;;
    snapshot)
        shift
        bash "$ASL_DIR/core/snapshot.sh" "$@"
        ;;
    orphan-killer|clean-orphans)
        shift
        bash "$ASL_DIR/core/orphan-killer.sh" "$@"
        ;;
    remote)
        shift
        bash "$ASL_DIR/desktop/remote.sh" "$@"
        ;;
    service|autostart|daemon|boot)
        shift
        bash "$ASL_DIR/core/service-manager.sh" "$@"
        ;;
    omniroute)
        shift
        OMNI_ACTION="${1:-status}"
        case "$OMNI_ACTION" in
            start)
                if [ -x "$HOME/omniroute-daemon.sh" ]; then
                    echo "[*] Starting OmniRoute AI proxy daemon as root..."
                    su -c "/data/data/com.termux/files/usr/bin/bash /data/data/com.termux/files/home/omniroute-daemon.sh" >> /data/data/com.termux/files/home/omniroute.log 2>&1 &
                    sleep 1
                    echo "[✓] OmniRoute daemon started."
                else
                    echo "[!] Error: $HOME/omniroute-daemon.sh not found."
                fi
                ;;
            stop)
                echo "[*] Stopping OmniRoute proxy..."
                pkill -f "omniroute" 2>/dev/null || true
                su -c "pkill -f omniroute" 2>/dev/null || true
                echo "[✓] OmniRoute stopped."
                ;;
            restart)
                pkill -f "omniroute" 2>/dev/null || true
                su -c "pkill -f omniroute" 2>/dev/null || true
                sleep 1
                if [ -x "$HOME/omniroute-daemon.sh" ]; then
                    su -c "/data/data/com.termux/files/usr/bin/bash /data/data/com.termux/files/home/omniroute-daemon.sh" >> /data/data/com.termux/files/home/omniroute.log 2>&1 &
                    echo "[✓] OmniRoute restarted."
                fi
                ;;
            logs|log)
                if [ -f "$HOME/omniroute.log" ]; then
                    tail -n 50 "$HOME/omniroute.log"
                else
                    echo "[!] No log file found at $HOME/omniroute.log"
                fi
                ;;
            status|"")
                echo "=== OmniRoute Local AI Proxy Status ==="
                if asl_is_omniroute_running; then
                    echo " Status:   ACTIVE"
                    echo " Endpoint: http://127.0.0.1:20128"
                    opid=$(pgrep -f "omniroute" 2>/dev/null | head -n 1 || true)
                    [ -z "$opid" ] && opid=$(su -c "pgrep -f omniroute 2>/dev/null | head -n 1" 2>/dev/null || true)
                    echo " PID:      ${opid:-active}"
                else
                    echo " Status:   INACTIVE"
                    echo " Endpoint: http://127.0.0.1:20128 (Down)"
                fi
                ;;
        esac
        ;;
    desktop)
        shift
        DESKTOP_ACTION="${1:-start}"
        case "$DESKTOP_ACTION" in start|stop|force-stop|kill|restart|status|refresh-x11|sync-apps|launch) ;; *) echo "Error: desktop accepts start, stop, force-stop, restart, status, sync-apps, launch, or refresh-x11."; exit 1 ;; esac
        if [[ "$DESKTOP_ACTION" = start || "$DESKTOP_ACTION" = restart || "$DESKTOP_ACTION" = sync-apps || "$DESKTOP_ACTION" = launch ]]; then
            ensure_mounted
        fi
        shift || true
        bash "$ASL_DIR/desktop/start-desktop.sh" "$DESKTOP_ACTION" "$@"
        ;;
    install)
        shift
        if [ $# -eq 0 ]; then
            echo "Usage: asl install <package_name...>"
            exit 1
        fi
        pkgs=()
        for pkg in "$@"; do
            if [[ ! "$pkg" =~ ^[A-Za-z0-9][A-Za-z0-9.+_-]*$ ]]; then
                echo "Error: Invalid package name: $pkg"
                exit 1
            fi
            pkgs+=("'$pkg'")
        done
        ensure_mounted
        echo "[*] Updating package lists and installing: $*..."
        run_in_chroot "apt-get update && apt-get install -y ${pkgs[*]}"
        ;;
    search)
        shift
        if [ $# -eq 0 ]; then
            echo "Usage: asl search <query>"
            exit 1
        fi
        terms=()
        for term in "$@"; do
            if [[ ! "$term" =~ ^[A-Za-z0-9][A-Za-z0-9.+:_-]*$ ]]; then
                echo "Error: Invalid search term: $term"
                exit 1
            fi
            terms+=("'$term'")
        done
        ensure_mounted
        run_in_chroot "apt-cache search ${terms[*]}"
        ;;
    mode)
        shift
        TARGET_MODE="${1:-status}"
        MODE_STATE="$HOME/.asl/asl_mode_state"
        case "$TARGET_MODE" in
            gaming|game)
                echo "[*] Applying Gaming Performance Profile & CPU Governor..."
                asl_exec "for g in /sys/devices/system/cpu/cpu*/cpufreq/scaling_governor; do echo performance > \"\$g\" 2>/dev/null || true; done" 2>/dev/null || true
                asl_exec "echo gaming > '$MODE_STATE'" 2>/dev/null || true
                echo "[✓] Gaming mode active: CPU governor set to performance, Turnip flags enabled."
                ;;
            performance|perf)
                echo "[*] Applying Maximum Performance Mode..."
                asl_exec "for g in /sys/devices/system/cpu/cpu*/cpufreq/scaling_governor; do echo performance > \"\$g\" 2>/dev/null || true; done" 2>/dev/null || true
                asl_exec "echo performance > '$MODE_STATE'" 2>/dev/null || true
                echo "[✓] Performance mode active: CPU governor set to performance."
                ;;
            balanced|normal)
                asl_exec "for g in /sys/devices/system/cpu/cpu*/cpufreq/scaling_governor; do echo schedutil > \"\$g\" 2>/dev/null || echo powersave > \"\$g\" 2>/dev/null || true; done" 2>/dev/null || true
                asl_exec "rm -f '$MODE_STATE'" 2>/dev/null || true
                unset TU_DEBUG
                echo "[✓] Balanced profile active: CPU governor reset."
                ;;
            status|"")
                GOV=$(cat /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor 2>/dev/null || echo "unknown")
                TU_MODE=$(asl_exec "cat '$MODE_STATE' 2>/dev/null" 2>/dev/null | tr -d '[:space:]')
                if [ -n "$TU_MODE" ]; then
                    echo "Current Profile Mode: Gaming ($TU_MODE) | Governor: $GOV"
                else
                    echo "Current Profile Mode: Balanced | Governor: $GOV"
                fi
                ;;
            *)
                echo "Usage: asl mode [gaming|performance|balanced|status]"
                exit 1
                ;;
        esac
        ;;
    resolution|res)
        shift
        RES="${1:-status}"
        SCALE="${2:-}"
        case "$RES" in
            720p)
                pkill -f "termux-x11.*:[0-9]" 2>/dev/null || true
                termux-x11 :0 -geometry 1280x720 +iglx -nolisten tcp -ac >/dev/null 2>&1 &
                echo "[✓] Termux:X11 display resolution set to 1280x720."
                ;;
            1080p)
                pkill -f "termux-x11.*:[0-9]" 2>/dev/null || true
                termux-x11 :0 -geometry 1920x1080 +iglx -nolisten tcp -ac >/dev/null 2>&1 &
                echo "[✓] Termux:X11 display resolution set to 1920x1080."
                ;;
            native)
                pkill -f "termux-x11.*:[0-9]" 2>/dev/null || true
                termux-x11 :0 +iglx -nolisten tcp -ac >/dev/null 2>&1 &
                echo "[✓] Termux:X11 display resolution set to native."
                ;;
            status|"")
                cur_res=$(ps aux | grep -i termux-x11 | grep -v grep | grep -oE '\-geometry [0-9]+x[0-9]+' || echo "native / default")
                echo "Current Termux:X11 Resolution: ${cur_res#-geometry }"
                echo "Usage: asl resolution [720p|1080p|native] [scale]"
                ;;
            *)
                echo "Error: Invalid resolution preset '$RES'. Use: 720p, 1080p, native"
                exit 1
                ;;
        esac
        if [ "$RES" = 720p ] || [ "$RES" = 1080p ] || [ "$RES" = native ]; then
            bash "$ASL_DIR/desktop/start-desktop.sh" refresh-x11 >/dev/null 2>&1 || true
        fi
        if is_mounted && [ -n "$SCALE" ]; then
            if [[ "$SCALE" =~ ^[0-9]+(\.[0-9]+)?$ ]]; then
                run_in_chroot "DISPLAY=:0 xfconf-query -c xsettings -p /Gtk/ScaleFactor -s $SCALE 2>/dev/null || true"
            else
                echo "Error: Scale must be a number (e.g. 1.25)."
            fi
        fi
        ;;
    swap|memory)
        shift
        bash "$ASL_DIR/core/swap-manager.sh" "$@"
        ;;
    kernel-check|kernel)
        shift
        bash "$ASL_DIR/core/kernel-check.sh" "$@"
        ;;
    audio)
        shift
        bash "$ASL_DIR/desktop/start-desktop.sh" audio "$@"
        ;;
    hud)
        shift
        bash "$ASL_DIR/core/hud.sh" "$@"
        ;;
    backup)
        asl_with_lock asl_backup
        ;;
    restore)
        shift
        asl_with_lock asl_restore "$@"
        ;;
    wakelock|wake|open|clip|clipboard|shortcut|app-shortcut|clip-sync|clipdaemon|toast|notify|notification|storage)
        bash "$ASL_DIR/core/termux-bridge.sh" "$@"
        ;;
    aid|gids)
        shift
        bash "$ASL_DIR/core/android-aid.sh" "$@"
        ;;
    wine-bundle)
        shift
        bash "$ASL_DIR/core/wine-bundle.sh" "$@"
        ;;
    wine-version)
        shift
        bash "$ASL_DIR/core/wine-version.sh" "$@"
        ;;
    gamepad)
        shift
        bash "$ASL_DIR/core/gamepad.sh" "$@"
        ;;
    aslpath|asl-path|path)
        shift
        bash "$ASL_DIR/core/asl-path.sh" "$@"
        ;;
    config|asl.conf|wsl.conf)
        shift
        bash "$ASL_DIR/core/asl-conf.sh" "$@"
        ;;
    dev-suite)
        shift
        bash "$ASL_DIR/core/dev-suite.sh" "$@"
        ;;
    security-suite)
        shift
        bash "$ASL_DIR/core/security-suite.sh" "$@"
        ;;
    clean)
        shift
        bash "$ASL_DIR/core/cleaner.sh" "$@"
        ;;
    repair)
        shift
        bash "$ASL_DIR/core/repair.sh" "$@"
        ;;
    hub|asl-hub|gui-hub)
        shift
        bash "$ASL_DIR/desktop/asl-hub-installer.sh" "$@"
        ;;
    host|apps|custom)
        shift
        SUB_CMD="${1:-menu}"
        shift || true
        case "$SUB_CMD" in
            wine|explorer) bash "$ASL_DIR/gaming/wine-box64.sh" desktop "$@" ;;
            winefile) bash "$ASL_DIR/gaming/wine-box64.sh" winefile "$@" ;;
            winecfg) bash "$ASL_DIR/gaming/wine-box64.sh" winecfg "$@" ;;
            winetricks) bash "$ASL_DIR/gaming/wine-box64.sh" winetricks "$@" ;;
            openbox) bash "$ASL_DIR/gaming/wine-box64.sh" openbox "$@" ;;
            xfce|desktop) bash "$ASL_DIR/desktop/start-desktop.sh" start "$@" ;;
            picker|gui) bash "$ASL_DIR/gaming/wine-box64.sh" picker "$@" ;;
            list)
                ensure_mounted
                echo "=== Modded Debian Application Launchers ==="
                asl_chroot_exec "ls /usr/share/applications/*.desktop /root/Desktop/*.desktop 2>/dev/null | sort -u" 2>/dev/null | sed 's|^.*/||' | awk '{print " - " $0}'
                ;;
            launch|run)
                APP="$1"
                if [ -z "$APP" ]; then
                    echo "Usage: asl host launch <desktop_file_or_binary>"
                    exit 1
                fi
                ensure_mounted
                launch_desktop_app "$APP"
                ;;
            menu|*)
                show_host_apps_menu
                ;;
        esac
        ;;
    help|-h|--help)
        show_help
        ;;
    "")
        if [ "$#" -gt 0 ]; then
            echo "Unknown command: (empty)"
            echo "Run 'asl help' for usage information."
            exit 1
        fi
        dashboard
        ;;
    *)
        echo "Unknown command: $1"
        echo "Run 'asl help' for usage information."
        exit 1
        ;;
esac
