#!/bin/bash
# Android Subsystem for Linux (ASL): Unified CLI Management Console

REAL_SCRIPT="$(readlink -f "${BASH_SOURCE[0]}")"
ASL_DIR="$(cd "$(dirname "$REAL_SCRIPT")/.." && pwd)"
if [ ! -d "$ASL_DIR/core" ]; then
    if [ -d "${PREFIX:-/data/data/com.termux/files/usr}/share/asl/core" ]; then
        ASL_DIR="${PREFIX:-/data/data/com.termux/files/usr}/share/asl"
    elif [ -d "$HOME/ASL/core" ]; then
        ASL_DIR="$HOME/ASL"
    fi
fi
DEBIANPATH="${DEBIANPATH:-/data/local/tmp/chrootDebian}"

export ASL_DIR DEBIANPATH

AUTO_CONFIRM=0
FILTERED_ARGS=()
for arg in "$@"; do
    case "$arg" in
        --yes|-y|--non-interactive) AUTO_CONFIRM=1 ;;
        *) FILTERED_ARGS+=("$arg") ;;
    esac
done
if [ ${#FILTERED_ARGS[@]} -gt 0 ]; then
    set -- "${FILTERED_ARGS[@]}"
else
    set --
fi
export AUTO_CONFIRM

if [ "${NO_COLOR:-}" = "" ]; then
    C_RESET=$'\033[0m'
    C_BOLD=$'\033[1m'
    C_CYAN=$'\033[36m'
    C_GREEN=$'\033[32m'
    C_YELLOW=$'\033[33m'
    C_RED=$'\033[31m'
    C_DIM=$'\033[2m'
    C_SHADOW=$'\033[90m'
else
    C_RESET=''; C_BOLD=''; C_CYAN=''; C_GREEN=''; C_YELLOW=''; C_RED=''; C_DIM=''; C_SHADOW=''
fi

status_label() {
    local state="$1"
    case "$state" in
        ACTIVE|RUNNING|READY|ON|ENABLED) printf '%s[%s]%s' "$C_GREEN$C_BOLD" "$state" "$C_RESET" ;;
        INACTIVE|STOPPED|OFF|DISABLED) printf '%s[%s]%s' "$C_DIM" "$state" "$C_RESET" ;;
        *) printf '%s[%s]%s' "$C_YELLOW$C_BOLD" "$state" "$C_RESET" ;;
    esac
}

status_badge() {
    local state="$1" width="${2:-9}"
    local tag="[${state}]"
    local pad=$(( width - ${#tag} ))
    [ "$pad" -lt 0 ] && pad=0
    local trail="" i
    for ((i=0; i<pad; i++)); do trail="${trail} "; done
    case "$state" in
        ACTIVE|RUNNING|READY|ON|ENABLED) printf "%s%s%s%s" "$C_GREEN$C_BOLD" "$tag" "$C_RESET" "$trail" ;;
        INACTIVE|STOPPED|OFF|DISABLED) printf "%s%s%s%s" "$C_DIM" "$tag" "$C_RESET" "$trail" ;;
        *) printf "%s%s%s%s" "$C_YELLOW$C_BOLD" "$tag" "$C_RESET" "$trail" ;;
    esac
}

section_title() { printf '%s%s%s\n' "$C_CYAN$C_BOLD" "$1" "$C_RESET"; }
menu_item() {
    if [ -n "${3:-}" ]; then
        printf '  %s%2s%s) %-42s %s%s%s\n' "$C_CYAN" "$1" "$C_RESET" "$2" "$C_YELLOW" "$3" "$C_RESET"
    else
        printf '  %s%2s%s) %s\n' "$C_CYAN" "$1" "$C_RESET" "$2"
    fi
}

if [ -f "$ASL_DIR/core/common.sh" ]; then
    source "$ASL_DIR/core/common.sh"
elif [ -f "${PREFIX:-/data/data/com.termux/files/usr}/share/asl/core/common.sh" ]; then
    source "${PREFIX:-/data/data/com.termux/files/usr}/share/asl/core/common.sh"
elif [ -f "$HOME/ASL/core/common.sh" ]; then
    source "$HOME/ASL/core/common.sh"
fi
if [ -f "$ASL_DIR/core/gpu-profile.sh" ]; then
    source "$ASL_DIR/core/gpu-profile.sh"
fi

ensure_mounted() {
    if ! is_mounted; then
        bash "$ASL_DIR/core/mount-chroot.sh" || exit 1
    fi
}

asl_with_lock() {
    asl_acquire_lock || { echo "[!] Another ASL operation is in progress; try again shortly."; return 1; }
    "$@"
    local rc=$?
    asl_release_lock
    return "$rc"
}

asl_backup() {
    local BACKUP_DIR="/sdcard/Debian_Backups"
    if is_mounted; then
        echo "[!] Stopping chroot before backup..."
        bash "$ASL_DIR/core/stop-chroot.sh" || return 1
    fi
    mkdir -p "$BACKUP_DIR" 2>/dev/null || BACKUP_DIR="/data/data/com.termux/files/home"
    local BACKUP_FILE PARTIAL_BACKUP
    BACKUP_FILE="$BACKUP_DIR/asl-backup-$(date +%Y%m%d_%H%M%S).tar.gz"
    PARTIAL_BACKUP="$BACKUP_FILE.partial"
    local required_mb target_free_mb
    required_mb=$(asl_exec "du -sm '$DEBIANPATH' 2>/dev/null" 2>/dev/null | awk '{print $1}')
    if [ -z "$required_mb" ] || [[ ! "$required_mb" =~ ^[0-9]+$ ]]; then
        required_mb=$(du -sm "$DEBIANPATH" 2>/dev/null | awk '{print $1}')
    fi
    target_free_mb=$(df -m "$BACKUP_DIR" 2>/dev/null | awk 'NR>=2 {for(i=1;i<=NF;i++) if($i ~ /^[0-9]+$/) free=$i} END{print free}')
    if [ -n "$required_mb" ] && [[ "$required_mb" =~ ^[0-9]+$ ]] && [ -n "$target_free_mb" ] && [[ "$target_free_mb" =~ ^[0-9]+$ ]] && [ "$target_free_mb" -lt "$required_mb" ]; then
        echo "[!] Insufficient disk space in $BACKUP_DIR: ${target_free_mb}MB free, ~${required_mb}MB needed."
        return 1
    fi
    echo "[*] Creating backup at $BACKUP_FILE..."
    if asl_exec "export PATH=\"/data/data/com.termux/files/usr/bin:/system/bin:\$PATH\"; tar --warning=no-file-changed -czf '$PARTIAL_BACKUP' --exclude='./dev*' --exclude='./proc*' --exclude='./sys*' --exclude='./run*' --exclude='./tmp*' -C '$DEBIANPATH' ." && asl_exec "test -s '$PARTIAL_BACKUP'"; then
        asl_exec "mv '$PARTIAL_BACKUP' '$BACKUP_FILE'"
        echo "[✓] Backup completed: $BACKUP_FILE"
    else
        asl_exec "rm -f '$PARTIAL_BACKUP'" 2>/dev/null || true
        echo "[!] Backup failed; no completed archive was created."
        return 1
    fi
}

asl_restore() {
    local RESTORE_FILE="${1:-}"
    if [ -z "$RESTORE_FILE" ] || [ ! -f "$RESTORE_FILE" ]; then
        echo "Error: Valid archive file required. Usage: asl restore <path/to/backup.tar.gz>"
        return 1
    fi
    if ! confirm_action "Restore Debian root from '$RESTORE_FILE'? This replaces the current chroot."; then
        echo "[*] Cancelled."
        return 0
    fi
    local BASE64_BIN restore_b64 archive_size_mb target_free_mb
    BASE64_BIN=$(command -v base64) || { echo "Error: base64 is required to restore an archive."; return 1; }
    restore_b64=$(printf '%s' "$RESTORE_FILE" | "$BASE64_BIN" | tr -d '\n')
    if ! asl_exec "export PATH=\"/data/data/com.termux/files/usr/bin:/system/bin:\$PATH\"; archive=\$(printf %s '$restore_b64' | '$BASE64_BIN' -d); tar -tzf \"\$archive\" >/dev/null && ! tar -tzf \"\$archive\" | grep -Eq '(^/|(^|/)\.\.(/|\$))'"; then
        echo "[!] Restore archive is unreadable or contains unsafe paths."
        return 1
    fi
    archive_size_mb=$(du -sm "$RESTORE_FILE" 2>/dev/null | awk '{print $1 * 3}')
    target_free_mb=$(df -m "$DEBIANPATH" 2>/dev/null | awk 'NR>=2 {for(i=1;i<=NF;i++) if($i ~ /^[0-9]+$/) free=$i} END{print free}')
    if [ -n "$archive_size_mb" ] && [[ "$archive_size_mb" =~ ^[0-9]+$ ]] && [ -n "$target_free_mb" ] && [[ "$target_free_mb" =~ ^[0-9]+$ ]] && [ "$target_free_mb" -lt "$archive_size_mb" ]; then
        echo "[!] Insufficient disk space on root filesystem: ${target_free_mb}MB free, ~${archive_size_mb}MB estimated needed."
        return 1
    fi
    if is_mounted; then
        echo "[!] Stopping chroot..."
        bash "$ASL_DIR/core/stop-chroot.sh" || return 1
    fi
    echo "[*] Staging restore from $RESTORE_FILE..."
    asl_exec "export PATH=\"/data/data/com.termux/files/usr/bin:/system/bin:\$PATH\"; archive=\$(printf %s '$restore_b64' | '$BASE64_BIN' -d); target='$DEBIANPATH'; parent=\${target%/*}; stage=\$(mktemp -d \"\$parent/.asl-restore.XXXXXX\") || exit 1; trap 'rm -rf \"\$stage\"' EXIT; tar -xzf \"\$archive\" -C \"\$stage\" || exit 1; rollback=\"\$target.pre-restore-\$(date +%Y%m%d_%H%M%S)\"; test ! -e \"\$rollback\" || exit 1; if ! mv \"\$target\" \"\$rollback\"; then echo '[!] Restore failed: could not move current root aside.' >&2; exit 1; fi; if ! mv \"\$stage\" \"\$target\"; then echo '[!] Restore failed: moving staged root into place failed; rolling back original root.' >&2; mv \"\$rollback\" \"\$target\" 2>/dev/null || true; exit 1; fi; stage=; trap - EXIT; printf '[✓] Restore completed. Previous Debian root retained at: %s\\n' \"\$rollback\"" || {
        echo "[!] Restore failed; the Debian root is unchanged (or was rolled back)."
        return 1
    }
}

asl_require_default_debianpath

run_in_chroot() {
    local command_text="$*"
    local command_b64 timeout_cmd=""

    # Validate command size to prevent truncation or argument limit issues
    if [ ${#command_text} -gt 40000 ]; then
        echo "[!] Error: Command is too large (${#command_text} chars; max ~40000 recommended)."
        return 1
    fi

    # Optional command timeout (seconds) so a hung chroot command cannot
    # block the console forever. Disabled unless ASL_CMD_TIMEOUT is set and
    # a `timeout` binary is available.
    if [ -n "${ASL_CMD_TIMEOUT:-}" ] && [[ "$ASL_CMD_TIMEOUT" =~ ^[0-9]+$ ]] && [ "$ASL_CMD_TIMEOUT" -gt 0 ]; then
        if command -v timeout >/dev/null 2>&1; then
            timeout_cmd="timeout --kill-after=15 --signal=TERM ${ASL_CMD_TIMEOUT} "
        elif [ -x /data/data/com.termux/files/usr/bin/timeout ]; then
            timeout_cmd="/data/data/com.termux/files/usr/bin/timeout --kill-after=15 --signal=TERM ${ASL_CMD_TIMEOUT} "
        fi
    fi

    command_b64=$(printf '%s' "$command_text" | base64 | tr -d '\n')

    if [ -z "$command_b64" ]; then
        echo "[!] Error: Failed to encode command."
        return 1
    fi

    asl_exec "chroot '$DEBIANPATH' /bin/bash --noprofile --norc -c 'export HOME=/root USER=root LOGNAME=root PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin TERM=xterm-256color LANG=C.UTF-8 LC_ALL=C.UTF-8; ${timeout_cmd}printf \"%s\" \"$command_b64\" | /usr/bin/base64 -d | /bin/bash'" || return $?
}

confirm_action() {
    local prompt="${1:-Are you sure?}" reply
    if [ "${AUTO_CONFIRM:-0}" = 1 ]; then
        return 0
    fi
    read -r -p "$prompt [y/N]: " reply
    case "$reply" in
        [yY]|[yY][eE][sS]) return 0 ;;
        *) return 1 ;;
    esac
}

launch_desktop_app() {
    local APP="$1"
    if [ -z "$APP" ]; then
        echo "[!] No application specified to launch."
        return 1
    fi
    local app_b64
    app_b64=$(printf '%s' "$APP" | base64 | tr -d '\n')
    run_in_chroot '
        export DISPLAY=:0
        export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:$PATH
        TARGET=$(printf "%s" "'"$app_b64"'" | base64 -d)
        if [[ "$TARGET" == *.desktop ]] && [ ! -f "$TARGET" ]; then
            if [ -f "/usr/share/applications/$TARGET" ]; then
                TARGET="/usr/share/applications/$TARGET"
            elif [ -f "/root/Desktop/$TARGET" ]; then
                TARGET="/root/Desktop/$TARGET"
            fi
        elif [ ! -f "$TARGET" ]; then
            if [ -f "/usr/share/applications/${TARGET}.desktop" ]; then
                TARGET="/usr/share/applications/${TARGET}.desktop"
            elif [ -f "/root/Desktop/${TARGET}.desktop" ]; then
                TARGET="/root/Desktop/${TARGET}.desktop"
            fi
        fi

        if [ -f "$TARGET" ] && [[ "$TARGET" == *.desktop ]]; then
            APP_BASE=$(basename "$TARGET" .desktop)
            if command -v gio >/dev/null 2>&1; then
                nohup gio launch "$TARGET" >/tmp/app_launch.log 2>&1 &
            elif command -v gtk-launch >/dev/null 2>&1; then
                nohup gtk-launch "$APP_BASE" >/tmp/app_launch.log 2>&1 &
            else
                EXEC_LINE=$(grep -E "^Exec=" "$TARGET" | head -n1 | cut -d"=" -f2-)
                EXEC_CMD=$(echo "$EXEC_LINE" | sed -E "s/%[fFuUiIck]//g")
                if [ -n "$EXEC_CMD" ]; then
                    nohup /bin/bash -c "$EXEC_CMD" >/tmp/app_launch.log 2>&1 &
                else
                    echo "[!] Could not parse Exec line from $TARGET"
                fi
            fi
        else
                nohup "$TARGET" >/tmp/app_launch.log 2>&1 &
        fi
        sleep 0.5
        if [ -s /tmp/app_launch.log ] && grep -qiE "error|failed|cannot open" /tmp/app_launch.log 2>/dev/null; then
            echo "[!] Diagnostics (/tmp/app_launch.log):"
            tail -n 5 /tmp/app_launch.log
        fi
    '
}

