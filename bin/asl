    echo "  Root-Accelerated Linux Environment & Gaming Container"
    echo "============================================================"
    echo "Usage: asl [dashboard|command] [args]  (or superkit [command])"
    echo ""
    echo "Dashboard:"
    echo "  dashboard, menu  Open the interactive terminal dashboard"
    echo "  overview         Show concise chroot, desktop, audio, X11, and GPU state"
    echo "  mode [gaming|performance|balanced] Configure performance profile"
    echo "  hud [on|off|toggle|status] Toggle MangoHud / DXVK performance overlay"
    echo "  thermal          Display battery and CPU/GPU thermal temperatures"
