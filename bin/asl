#!/bin/bash
# Android Subsystem for Linux (ASL): Unified CLI Management Console

REAL_SCRIPT="$(readlink -f "${BASH_SOURCE[0]}")"
ASL_DIR="$(cd "$(dirname "$REAL_SCRIPT")/.." && pwd)"
if [ ! -d "$ASL_DIR/core" ] && [ -d "$HOME/ASL/core" ]; then
    ASL_DIR="$HOME/ASL"
fi
DEBIANPATH="${DEBIANPATH:-/data/local/tmp/chrootDebian}"

export ASL_DIR DEBIANPATH

if [ "${NO_COLOR:-}" = "" ]; then
    C_RESET=$'\033[0m'
    C_BOLD=$'\033[1m'
    C_CYAN=$'\033[36m'
    C_GREEN=$'\033[32m'
    C_YELLOW=$'\033[33m'
    C_RED=$'\033[31m'
    C_DIM=$'\033[2m'
    C_SHADOW=$'\033[90m'
else
    C_RESET= C_BOLD= C_CYAN= C_GREEN= C_YELLOW= C_RED= C_DIM= C_SHADOW=
fi

status_label() {
    local state="$1"
    case "$state" in
        ACTIVE|RUNNING|READY) printf '%s%s%s' "$C_GREEN" "$state" "$C_RESET" ;;
        INACTIVE|STOPPED) printf '%s%s%s' "$C_DIM" "$state" "$C_RESET" ;;
        *) printf '%s%s%s' "$C_YELLOW" "$state" "$C_RESET" ;;
    esac
}

section_title() { printf '%s%s%s\n' "$C_CYAN$C_BOLD" "$1" "$C_RESET"; }
menu_item() {
    if [ -n "${3:-}" ]; then
        printf '  %s%2s%s) %-42s %s%s%s\n' "$C_CYAN" "$1" "$C_RESET" "$2" "$C_YELLOW" "$3" "$C_RESET"
    else
        printf '  %s%2s%s) %s\n' "$C_CYAN" "$1" "$C_RESET" "$2"
    fi
}

if [ "$DEBIANPATH" != "/data/local/tmp/chrootDebian" ]; then
    echo "Error: DEBIANPATH must be /data/local/tmp/chrootDebian"
    exit 2
fi

is_mounted() {
    su -c "grep -q -w '$DEBIANPATH/proc' /proc/mounts" 2>/dev/null
}

run_in_chroot() {
    local command_text="$*"
    local command_b64

    command_b64=$(printf '%s' "$command_text" | base64 | tr -d '\n')
    su -c "chroot '$DEBIANPATH' /bin/bash --noprofile --norc -c 'export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin TERM=xterm LANG=C.UTF-8 LC_ALL=C.UTF-8; printf %s $command_b64 | /usr/bin/base64 -d | /bin/bash'"
}

show_help() {
    echo "============================================================"
    echo "    Android Subsystem for Linux (ASL) Console v1.0"
    echo "  Root-Accelerated Linux Environment & Gaming Container"
    echo "============================================================"
    echo "Usage: asl [dashboard|command] [args]  (or superkit [command])"
    echo ""
    echo "Dashboard:"
    echo "  dashboard, menu  Open the interactive terminal dashboard"
    echo "  overview         Show concise chroot, desktop, audio, X11, and GPU state"
    echo "  mode [gaming|performance|balanced] Configure performance profile"
    echo "  thermal          Display battery and CPU/GPU thermal temperatures"
    echo ""
    echo "Core Chroot Commands:"
    echo "  start            Start & mount Debian chroot safely"
    echo "  stop             Stop & unmount Debian chroot"
    echo "  status           Show chroot status, size, and mounts"
    echo "  doctor           Check ASL prerequisites without changing state"
    echo "  shell [user]     Enter interactive shell (default: root)"
    echo "  exec <cmd>       Execute a single command inside chroot"
    echo "  install <pkg..>  Install Debian packages via apt-get"
    echo "  search <query>   Search available Debian packages"
    echo "  service <act> <name> Manage Debian background services (start|stop|restart|status)"
    echo "  snapshot [act]   Fast chroot snapshots (create|list|restore|delete)"
    echo "  backup           Backup chroot to tar.gz archive"
    echo "  restore <file>   Restore chroot from tar.gz archive"
    echo ""
    echo "MoBox Gaming Commands:"
    echo "  setup-gaming     Auto-install Wine, Box64, DXVK, and VKD3D dependencies"
    echo "  game [exe]       Launch Windows .exe with Box64 + Wine"
    echo "  benchmark        Run GPU hardware acceleration & Vulkan rendering benchmark"
    echo "  gpu              Detect SoC & configure Turnip/Zink/VirGL"
    echo ""
    echo "Termux Desktop & Remote Commands:"
    echo "  desktop start    Start ASL-managed XFCE4 desktop"
    echo "  desktop stop     Stop only the ASL-managed desktop"
    echo "  desktop status   Show desktop lifecycle status"
    echo "  desktop sync-apps Create ASL-owned Termux launchers"
    echo "  theme [preset]   Set XFCE look & feel (dark|light|nord|dracula)"
    echo "  resolution [preset] Set Termux:X11 display resolution (720p|1080p|native)"
    echo "  remote [ssh|vnc] Manage SSH/VNC remote access servers"
    echo "  audio [start|stop|test|volume <level>] Manage PulseAudio sound server"
    echo ""
    echo "Termux & Android Bridge Commands:"
    echo "  open <target>    Open file or URL in default Android host application"
    echo "  clip [copy|paste] Set or read Android system clipboard content"
    echo "  wakelock [on|off] Acquire or release Termux CPU wake lock"
    echo "  toast <message>  Display quick Android system toast message"
    echo "  notify <t> <m>   Display Android notification banner"
    echo "  storage          Request Android shared storage permission"
    echo "  aid [setup]      Map Android system GIDs (aid_graphics, aid_audio, aid_sdcard_rw)"
    echo ""
    echo "Utility Commands:"
    echo "  help             Show this help message"
    echo ""
}

pause_dashboard() {
    echo ""
    read -r -p "Press Enter to return to the dashboard..." _
}

draw_bar() {
    local pct="$1" width="${2:-10}" filled empty bar_color i
    [ "$pct" -gt 100 ] && pct=100
    [ "$pct" -lt 0 ] && pct=0
    filled=$(( (pct * width) / 100 ))
    empty=$(( width - filled ))
    if [ "$pct" -ge 85 ]; then bar_color="$C_RED"
    elif [ "$pct" -ge 70 ]; then bar_color="$C_YELLOW"
    else bar_color="$C_GREEN"; fi
    printf '%s' "$bar_color"
    for ((i=0; i<filled; i++)); do printf '█'; done
    printf '%s' "$C_DIM"
    for ((i=0; i<empty; i++)); do printf '░'; done
    printf '%s' "$C_RESET"
}

asl_uptime() {
    local up d h m
    up=$(awk '{printf "%d", $1}' /proc/uptime 2>/dev/null || true)
    [ -n "$up" ] && [ "$up" -gt 0 ] 2>/dev/null || up=$(su -c "awk '{printf \"%d\", \$1}' /proc/uptime 2>/dev/null" 2>/dev/null | tr -d '[:space:]')
    [ -n "$up" ] || { printf '?'; return; }
    d=$((up / 86400)); up=$((up % 86400))
    h=$((up / 3600)); m=$(((up % 3600) / 60))
    if [ "$d" -gt 0 ]; then printf '%dd %dh' "$d" "$h"
    elif [ "$h" -gt 0 ]; then printf '%dh %02dm' "$h" "$m"
    else printf '%dm' "$m"; fi
}

asl_cpu_freq() {
    local f
    f=$(su -c "cat /sys/devices/system/cpu/cpu0/cpufreq/scaling_cur_freq 2>/dev/null" 2>/dev/null | tr -d '[:space:]')
    if [ -n "$f" ] && [ "$f" -gt 0 ] 2>/dev/null; then
        printf '%dMHz' "$((f / 1000))"
    else
        printf '?'
    fi
}

asl_host_ip() {
    local ip
    ip=$(ip -o -4 addr show 2>/dev/null | awk '$2 != "lo" {sub(/\/.*/, "", $4); print $4; exit}')
    [ -n "$ip" ] || ip=$(ifconfig 2>/dev/null | awk '/inet / && !/127.0.0.1/ {sub(/addr:/, ""); print $2; exit}')
    printf '%s' "${ip:-127.0.0.1}"
}

batt_temp_c() {
    local raw
    raw=$(cat /sys/class/power_supply/battery/temp 2>/dev/null | tr -d '[:space:]')
    if [[ "$raw" =~ ^[0-9]+$ ]] && [ "$raw" -gt 0 ]; then
        if [ "$raw" -gt 1000 ]; then printf '%d' "$((raw / 1000))"
        elif [ "$raw" -gt 100 ]; then printf '%d' "$((raw / 10))"
        else printf '%d' "$raw"; fi
        return
    fi
    su -c "dumpsys battery" 2>/dev/null | awk '/temperature:/ {printf "%d", int($2 / 10); exit}'
}

asl_gpu_cached() {
    local now
    now=$(date +%s 2>/dev/null || echo 0)
    if [ "$((now - ${ASL_GPU_CACHE_T:-0}))" -lt 30 ] && [ -n "${ASL_GPU_PROFILE:-}" ]; then
        return 0
    fi
    asl_gpu_detect
    ASL_GPU_CACHE_T=$now
}

overview() {
    local desktop_state desktop_status desktop_detail x11_socket
    local mem_total mem_avail mem_used mem_pct disk_data load_avg
    local swap_total swap_free swap_used swap_pct governor
    local batt_level batt_temp cpu_temp batt_str cpu_str host_ip wlock_status
    local up_str freq_str swap_from_zram

    host_ip=$(asl_host_ip)

    wlock_status="OFF"
    if pgrep -f "termux-wake-lock" >/dev/null 2>&1; then
        wlock_status="ON"
    fi

    x11_socket="${TMPDIR:-${PREFIX:-/data/data/com.termux/files/usr}/tmp}/.X11-unix/X0"
    desktop_state=$(bash "$ASL_DIR/desktop/start-desktop.sh" status 2>/dev/null | tr '\n' ' ')
    desktop_state=${desktop_state#Desktop: }
    desktop_state=${desktop_state% }
    desktop_status=${desktop_state%% *}
    desktop_detail=${desktop_state#"$desktop_status"}
    source "$ASL_DIR/core/gpu-profile.sh"
    asl_gpu_cached

    mem_total=$(awk '/MemTotal/ {print int($2/1024)}' /proc/meminfo 2>/dev/null || echo 0)
    mem_avail=$(awk '/MemAvailable/ {print int($2/1024)}' /proc/meminfo 2>/dev/null || echo 0)
    if [ "$mem_total" -gt 0 ]; then
        mem_used=$((mem_total - mem_avail))
        mem_pct=$((mem_used * 100 / mem_total))
    else
        mem_used=0; mem_pct=0
    fi

    swap_from_zram=0
    swap_total=$(awk '/SwapTotal/ {print int($2/1024)}' /proc/meminfo 2>/dev/null || echo 0)
    swap_free=$(awk '/SwapFree/ {print int($2/1024)}' /proc/meminfo 2>/dev/null || echo 0)
    if [ "$swap_total" -le 0 ]; then
        local zram_size zram_used_raw
        zram_size=$(su -c "cat /sys/block/zram0/disksize 2>/dev/null" 2>/dev/null | tr -d '[:space:]')
        zram_used_raw=$(su -c "cat /sys/block/zram0/mem_used_total 2>/dev/null" 2>/dev/null | tr -d '[:space:]')
        if [ -n "$zram_size" ] && [ "$zram_size" -gt 0 ] 2>/dev/null; then
            swap_total=$((zram_size / 1048576))
            swap_used=$((zram_used_raw / 1048576))
            [ "$swap_used" -gt "$swap_total" ] && swap_used=$swap_total
            swap_pct=$((swap_used * 100 / swap_total))
            swap_from_zram=1
        fi
    fi
    if [ "$swap_from_zram" -eq 0 ]; then
        if [ "$swap_total" -gt 0 ]; then
            swap_used=$((swap_total - swap_free))
            swap_pct=$((swap_used * 100 / swap_total))
        else
            swap_used=0; swap_pct=0
        fi
    fi

    governor=$(cat /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor 2>/dev/null || echo "unknown")
    disk_data=$(df -h /data 2>/dev/null | awk 'NR==2 {print $4 " free of " $2}')
    [ -n "$disk_data" ] || disk_data="unknown"
    load_avg=$(su -c "cat /proc/loadavg" 2>/dev/null | cut -d' ' -f1-3)
    [ -n "$load_avg" ] || load_avg="unknown"

    batt_level=$(cat /sys/class/power_supply/battery/capacity 2>/dev/null || su -c "dumpsys battery" 2>/dev/null | awk '/level:/ {print $2}')
    batt_temp=$(batt_temp_c)
    cpu_temp=$(cat /sys/class/thermal/thermal_zone*/temp 2>/dev/null | awk '$1>1000 {$1=int($1/1000)} $1>=20 && $1<=100 {print $1; exit}')

    if [ -n "$batt_level" ]; then
        batt_str="${batt_level}%"
        [ -n "$batt_temp" ] && batt_str="${batt_str} (${batt_temp}°C)"
    else
        batt_str="N/A"
    fi
    cpu_str="${cpu_temp:-N/A}°C"
    up_str=$(asl_uptime)
    freq_str=$(asl_cpu_freq)

    printf '%s╔══════════════════════════════════════════════════════════════════════════════╗%s\n' "$C_CYAN$C_BOLD" "$C_RESET"
    printf '%s║ 🚀 %sANDROID SUBSYSTEM FOR LINUX (ASL)%s                                      ║%s█%s\n' "$C_CYAN$C_BOLD" "$C_YELLOW$C_BOLD" "$C_CYAN$C_BOLD" "$C_SHADOW" "$C_RESET"
    printf '%s╠══════════════════════════════════════════════════════════════════════════════╣%s█%s\n' "$C_CYAN$C_BOLD" "$C_SHADOW" "$C_RESET"
    printf '%s║%s 🛡️ Chroot:  ' "$C_CYAN$C_BOLD" "$C_RESET"
    if is_mounted; then status_label ACTIVE; else status_label INACTIVE; fi
    printf '   🖥️ Desktop: '
    status_label "${desktop_status:-UNKNOWN}"
    printf ' %-16s ⚡ GPU: %s%-18s%s %s║%s█%s\n' "${desktop_detail:0:16}" "$C_YELLOW" "${ASL_GPU_PROFILE:0:18}" "$C_RESET" "$C_CYAN$C_BOLD" "$C_SHADOW" "$C_RESET"
    printf '%s║%s 📡 X11:     ' "$C_CYAN$C_BOLD" "$C_RESET"
    if [ -S "$x11_socket" ]; then status_label READY; else status_label STOPPED; fi
    printf '        🔊 Audio:   '
    if pgrep -x pulseaudio >/dev/null 2>&1; then status_label RUNNING; else status_label STOPPED; fi
    printf '      ⚙️ Gov: %s%-11s%s %s║%s█%s\n' "$C_GREEN" "${governor:0:11}" "$C_RESET" "$C_CYAN$C_BOLD" "$C_SHADOW" "$C_RESET"
    printf '%s║%s 🔋 Batt:    %s%-13s%s 🌡️ CPU: %s%-8s%s  🔒 Wake: %s%-3s%s             %s║%s█%s\n' "$C_CYAN$C_BOLD" "$C_RESET" "$C_CYAN" "${batt_str:0:13}" "$C_RESET" "$C_YELLOW" "${cpu_str:0:8}" "$C_RESET" "$C_GREEN" "${wlock_status:0:3}" "$C_RESET" "$C_CYAN$C_BOLD" "$C_SHADOW" "$C_RESET"
    printf '%s║%s 🌐 Host IP: %s%-15s%s                       📊 Data: %s%-17s%s %s║%s█%s\n' "$C_CYAN$C_BOLD" "$C_RESET" "$C_CYAN" "${host_ip:0:15}" "$C_RESET" "$C_CYAN" "${disk_data:0:17}" "$C_RESET" "$C_CYAN$C_BOLD" "$C_SHADOW" "$C_RESET"
    printf '%s╟──────────────────────────────────────────────────────────────────────────────╢%s█%s\n' "$C_CYAN$C_BOLD" "$C_SHADOW" "$C_RESET"
    printf '%s║%s 💾 RAM:  [' "$C_CYAN$C_BOLD" "$C_RESET"
    draw_bar "$mem_pct" 12
    printf '] %3d%%  (%4d / %4d MB)   Load: %s%-16s%s %s║%s█%s\n' "$mem_pct" "$mem_used" "$mem_total" "$C_YELLOW" "${load_avg:0:16}" "$C_RESET" "$C_CYAN$C_BOLD" "$C_SHADOW" "$C_RESET"
    printf '%s║%s 🔄 Swap: [' "$C_CYAN$C_BOLD" "$C_RESET"
    draw_bar "$swap_pct" 12
    printf '] %3d%%  (%4d / %4d MB)                                %s║%s█%s\n' "$swap_pct" "$swap_used" "$swap_total" "$C_CYAN$C_BOLD" "$C_SHADOW" "$C_RESET"
    printf '%s║%s ⏱️ Uptime:  %s%-16s%s        ⚡ Freq: %s%-7s%s %s║%s█%s\n' "$C_CYAN$C_BOLD" "$C_RESET" "$C_YELLOW" "$up_str" "$C_RESET" "$C_GREEN" "$freq_str" "$C_RESET" "$C_CYAN$C_BOLD" "$C_SHADOW" "$C_RESET"
    printf '%s╚══════════════════════════════════════════════════════════════════════════════╝%s█%s\n' "$C_CYAN$C_BOLD" "$C_SHADOW" "$C_RESET"
    printf ' %s▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀%s\n' "$C_SHADOW" "$C_RESET"
}

process_manager() {
    local sort_mode="cpu"
    while true; do
        clear 2>/dev/null || true
        printf '%s============================================================%s\n' "$C_CYAN$C_BOLD" "$C_RESET"
        printf '%s           ASL Resource & Process Manager%s\n' "$C_CYAN$C_BOLD" "$C_RESET"
        printf '%s============================================================%s\n\n' "$C_CYAN$C_BOLD" "$C_RESET"
        if [ "$sort_mode" = "mem" ]; then
            printf '%sTop Processes by RAM / Memory Usage (%s%s%s):%s\n' "$C_CYAN$C_BOLD" "$C_YELLOW" "sorted by %MEM" "$C_CYAN$C_BOLD" "$C_RESET"
            su -c "ps -eo pid,user,%cpu,%mem,rss,comm --sort=-%mem | head -n 12" 2>/dev/null || ps aux | head -n 12
        else
            printf '%sTop Processes by CPU Usage (%s%s%s):%s\n' "$C_CYAN$C_BOLD" "$C_YELLOW" "sorted by %CPU" "$C_CYAN$C_BOLD" "$C_RESET"
            su -c "ps -eo pid,user,%cpu,%mem,rss,comm --sort=-%cpu | head -n 12" 2>/dev/null || ps aux | head -n 12
        fi
        echo ""
        echo "Actions:"
        echo "  1) Refresh list"
        echo "  2) Toggle sort mode (CPU <-> RAM)"
        echo "  3) Terminate process (SIGTERM)"
        echo "  4) Force kill process (SIGKILL)"
        echo "  5) Return to menu"
        echo ""
        read -r -p "Select action [1-5]: " pm_act
        case "$pm_act" in
            2)
                if [ "$sort_mode" = "cpu" ]; then sort_mode="mem"; else sort_mode="cpu"; fi
                ;;
            3)
                read -r -p "Enter PID to terminate: " target_pid
                if [[ "$target_pid" =~ ^[0-9]+$ ]]; then
                    su -c "kill '$target_pid'" 2>/dev/null && echo "[✓] Sent SIGTERM to PID $target_pid" || echo "[!] Failed to terminate PID $target_pid"
                else
                    echo "[!] Invalid PID format."
                fi
                pause_dashboard
                ;;
            4)
                read -r -p "Enter PID to force kill: " target_pid
                if [[ "$target_pid" =~ ^[0-9]+$ ]]; then
                    su -c "kill -9 '$target_pid'" 2>/dev/null && echo "[✓] Sent SIGKILL to PID $target_pid" || echo "[!] Failed to kill PID $target_pid"
                else
                    echo "[!] Invalid PID format."
                fi
                pause_dashboard
                ;;
            1) continue ;;
            5|*) break ;;
        esac
        done
}

watch_dashboard() {
    trap 'break' INT
    while true; do
        clear 2>/dev/null || true
        overview
        echo ""
        printf '%sTop Processes by CPU Usage%s\n' "$C_CYAN$C_BOLD" "$C_RESET"
        printf '%s%-7s %-8s %7s %6s  %s%s\n' "$C_DIM" "PID" "USER" "%CPU" "%MEM" "COMMAND" "$C_RESET"
        su -c "ps -eo pid,user,%cpu,%mem,comm --sort=-%cpu | head -n 9 | tail -n +2" 2>/dev/null || true
        echo ""
        printf '%s[%s] Up %s | Ctrl+C to return to dashboard%s\n' "$C_DIM" "$(date '+%H:%M:%S' 2>/dev/null || echo '?')" "$(asl_uptime)" "$C_RESET"
        sleep 2
    done
    trap - INT
}

dashboard() {
    local C_SHADOW=$'\033[90m'
    while true; do
        clear 2>/dev/null || true
        overview
        echo ""
        printf '  %s┌─ 🐧 Linux Chroot ──────────────┐%s   %s┌─ 🖥️ Desktop & Remote ─────────────┐%s\n' "$C_CYAN$C_BOLD" "$C_RESET" "$C_CYAN$C_BOLD" "$C_RESET"
        printf '  %s│%s %s[s]%s 1. Start / Mount Chroot    %s│%s   %s│%s %s[d]%s 7. Start XFCE4 Desktop     %s│%s\n' "$C_CYAN$C_BOLD" "$C_RESET" "$C_YELLOW" "$C_RESET" "$C_CYAN$C_BOLD" "$C_RESET" "$C_CYAN$C_BOLD" "$C_RESET" "$C_YELLOW" "$C_RESET" "$C_CYAN$C_BOLD" "$C_RESET"
        printf '  %s│%s %s[x]%s 2. Stop & Unmount Chroot   %s│%s   %s│%s    8. Desktop Status / Stop     %s│%s\n' "$C_CYAN$C_BOLD" "$C_RESET" "$C_YELLOW" "$C_RESET" "$C_CYAN$C_BOLD" "$C_RESET" "$C_CYAN$C_BOLD" "$C_RESET" "$C_CYAN$C_BOLD" "$C_RESET"
        printf '  %s│%s    3. Open Root Shell         %s│%s   %s│%s    9. Theme & Resolution        %s│%s\n' "$C_CYAN$C_BOLD" "$C_RESET" "$C_CYAN$C_BOLD" "$C_RESET" "$C_CYAN$C_BOLD" "$C_RESET" "$C_CYAN$C_BOLD" "$C_RESET"
        printf '  %s│%s    4. Run Single Command      %s│%s   %s│%s %s[v]%s 10. Remote SSH / VNC Manager %s│%s\n' "$C_CYAN$C_BOLD" "$C_RESET" "$C_CYAN$C_BOLD" "$C_RESET" "$C_CYAN$C_BOLD" "$C_RESET" "$C_YELLOW" "$C_RESET" "$C_CYAN$C_BOLD" "$C_RESET"
        printf '  %s│%s    5. Snapshots & Backups     %s│%s   %s│%s    11. PulseAudio Audio Control %s│%s\n' "$C_CYAN$C_BOLD" "$C_RESET" "$C_CYAN$C_BOLD" "$C_RESET" "$C_CYAN$C_BOLD" "$C_RESET" "$C_CYAN$C_BOLD" "$C_RESET"
        printf '  %s│%s %s[a]%s 6. Android AID Group Setup %s│%s   %s│%s    12. Sync Debian App Launchers%s│%s\n' "$C_CYAN$C_BOLD" "$C_RESET" "$C_YELLOW" "$C_RESET" "$C_CYAN$C_BOLD" "$C_RESET" "$C_CYAN$C_BOLD" "$C_RESET" "$C_CYAN$C_BOLD" "$C_RESET"
        printf '  %s└────────────────────────────────┘%s   %s└────────────────────────────────┘%s\n\n' "$C_CYAN$C_BOLD" "$C_RESET" "$C_CYAN$C_BOLD" "$C_RESET"

        printf '  %s┌─ 🎮 Gaming Engine ─────────────┐%s   %s┌─ 📱 Android Bridge ────────────┐%s\n' "$C_CYAN$C_BOLD" "$C_RESET" "$C_CYAN$C_BOLD" "$C_RESET"
        printf '  %s│%s %s[g]%s 13. Run Windows .exe       %s│%s   %s│%s %s[k]%s 16. CPU Wake Lock Toggle   %s│%s\n' "$C_CYAN$C_BOLD" "$C_RESET" "$C_YELLOW" "$C_RESET" "$C_CYAN$C_BOLD" "$C_RESET" "$C_CYAN$C_BOLD" "$C_RESET" "$C_YELLOW" "$C_RESET" "$C_CYAN$C_BOLD" "$C_RESET"
        printf '  %s│%s %s[m]%s 14. Performance Mode       %s│%s   %s│%s %s[o]%s 17. Open File in Host App  %s│%s\n' "$C_CYAN$C_BOLD" "$C_RESET" "$C_YELLOW" "$C_RESET" "$C_CYAN$C_BOLD" "$C_RESET" "$C_CYAN$C_BOLD" "$C_RESET" "$C_YELLOW" "$C_RESET" "$C_CYAN$C_BOLD" "$C_RESET"
        printf '  %s│%s    15. Setup Wine / Box64     %s│%s   %s│%s %s[c]%s 18. System Clipboard Sync  %s│%s\n' "$C_CYAN$C_BOLD" "$C_RESET" "$C_CYAN$C_BOLD" "$C_RESET" "$C_CYAN$C_BOLD" "$C_RESET" "$C_YELLOW" "$C_RESET" "$C_CYAN$C_BOLD" "$C_RESET"
        printf '  %s│%s                              %s│%s   %s│%s %s[n]%s 19. Send Toast / Notice    %s│%s\n' "$C_CYAN$C_BOLD" "$C_RESET" "$C_CYAN$C_BOLD" "$C_RESET" "$C_CYAN$C_BOLD" "$C_RESET" "$C_YELLOW" "$C_RESET" "$C_CYAN$C_BOLD" "$C_RESET"
        printf '  %s└────────────────────────────────┘%s   %s└────────────────────────────────┘%s\n\n' "$C_CYAN$C_BOLD" "$C_RESET" "$C_CYAN$C_BOLD" "$C_RESET"

        printf '  %s┌─ 📊 Diagnostics & Monitor ──────────────────────────────────────────┐%s\n' "$C_CYAN$C_BOLD" "$C_RESET"
        printf '  %s│%s %s[p]%s 20. Resource & Process Manager    %s[t]%s 21. Thermal & Battery Monitor %s│%s\n' "$C_CYAN$C_BOLD" "$C_RESET" "$C_YELLOW" "$C_RESET" "$C_YELLOW" "$C_RESET" "$C_CYAN$C_BOLD" "$C_RESET"
        printf '  %s│%s    22. Read-Only Environment Check       23. GPU Hardware Profile     %s│%s\n' "$C_CYAN$C_BOLD" "$C_RESET" "$C_CYAN$C_BOLD" "$C_RESET"
        printf '  %s└─────────────────────────────────────────────────────────────────────┘%s\n\n' "$C_CYAN$C_BOLD" "$C_RESET"

        printf '  %s[h]%s Help   %s[r]%s Refresh   %s[w]%s Watch Live   %s[q]%s Exit\n\n' "$C_YELLOW" "$C_RESET" "$C_YELLOW" "$C_RESET" "$C_YELLOW" "$C_RESET" "$C_YELLOW" "$C_RESET"
        read -r -p "Select choice or hotkey: " choice

        case "$choice" in
            1|s|S) bash "$REAL_SCRIPT" start; pause_dashboard ;;
            2|x|X)
                read -r -p "Stop all chroot processes and unmount Debian? [y/N]: " confirm
                if [[ "$confirm" =~ ^[Yy]$ ]]; then bash "$REAL_SCRIPT" stop; fi
                pause_dashboard ;;
            3) bash "$REAL_SCRIPT" shell ;;
            4)
                read -r -p "Debian command: " command
                if [ -n "$command" ]; then bash "$REAL_SCRIPT" exec "$command"; fi
                pause_dashboard ;;
            5)
                echo "Snapshot actions: 1) list  2) create  3) restore  4) delete  5) backup (tar.gz)"
                read -r -p "Select action [1-5]: " s_act
                case "$s_act" in
                    1) bash "$REAL_SCRIPT" snapshot list ;;
                    2) read -r -p "Snapshot name: " s_name; bash "$REAL_SCRIPT" snapshot create "$s_name" ;;
                    3) read -r -p "Snapshot name to restore: " s_name; bash "$REAL_SCRIPT" snapshot restore "$s_name" ;;
                    4) read -r -p "Snapshot name to delete: " s_name; bash "$REAL_SCRIPT" snapshot delete "$s_name" ;;
                    5) bash "$REAL_SCRIPT" backup ;;
                esac
                pause_dashboard ;;
            6|a|A) bash "$REAL_SCRIPT" aid setup; pause_dashboard ;;
            7|d|D) bash "$REAL_SCRIPT" desktop start; pause_dashboard ;;
            8)
                echo "Desktop actions: 1) status  2) restart  3) stop"
                read -r -p "Select action [1-3]: " d_act
                case "$d_act" in
                    2) bash "$REAL_SCRIPT" desktop restart ;;
                    3) bash "$REAL_SCRIPT" desktop stop ;;
                    *) bash "$REAL_SCRIPT" desktop status ;;
                esac
                pause_dashboard ;;
            9)
                echo "Appearance options: 1) Theme preset  2) Termux:X11 Resolution"
                read -r -p "Select option [1-2]: " app_act
                case "$app_act" in
                    1)
                        echo "Presets: dark, light, nord, dracula, greybird"
                        read -r -p "Theme name: " t_preset
                        [ -n "$t_preset" ] && bash "$REAL_SCRIPT" theme "$t_preset"
                        ;;
                    2)
                        echo "Presets: 720p, 1080p, native"
                        read -r -p "Resolution preset: " r_preset
                        [ -n "$r_preset" ] && bash "$REAL_SCRIPT" resolution "$r_preset"
                        ;;
                esac
                pause_dashboard ;;
            10|v|V)
                echo "Remote actions: 1) SSH start  2) SSH stop  3) VNC start  4) VNC stop  5) status"
                read -r -p "Select action [1-5]: " r_act
                case "$r_act" in
                    1) bash "$REAL_SCRIPT" remote ssh start ;;
                    2) bash "$REAL_SCRIPT" remote ssh stop ;;
                    3) bash "$REAL_SCRIPT" remote vnc start ;;
                    4) bash "$REAL_SCRIPT" remote vnc stop ;;
                    *) bash "$REAL_SCRIPT" remote status ;;
                esac
                pause_dashboard ;;
            11) bash "$REAL_SCRIPT" audio; pause_dashboard ;;
            12) bash "$REAL_SCRIPT" desktop sync-apps; pause_dashboard ;;
            13|g|G)
                read -r -p "Full path to Windows .exe: " exe_path
                if [ -n "$exe_path" ]; then bash "$REAL_SCRIPT" game run "$exe_path"; fi
                pause_dashboard ;;
            14|m|M)
                echo "Modes: 1) gaming  2) performance  3) balanced"
                read -r -p "Select mode [1-3]: " m_act
                case "$m_act" in
                    1) bash "$REAL_SCRIPT" mode gaming ;;
                    2) bash "$REAL_SCRIPT" mode performance ;;
                    3) bash "$REAL_SCRIPT" mode balanced ;;
                    *) bash "$REAL_SCRIPT" mode status ;;
                esac
                pause_dashboard ;;
            15) bash "$REAL_SCRIPT" setup-gaming; pause_dashboard ;;
            16|k|K)
                echo "Wake lock actions: 1) status  2) enable (on)  3) disable (off)"
                read -r -p "Select action [1-3]: " w_act
                case "$w_act" in
                    2) bash "$REAL_SCRIPT" wakelock on ;;
                    3) bash "$REAL_SCRIPT" wakelock off ;;
                    *) bash "$REAL_SCRIPT" wakelock status ;;
                esac
                pause_dashboard ;;
            17|o|O)
                read -r -p "Enter file path or URL to open in Android host: " target_open
                if [ -n "$target_open" ]; then bash "$REAL_SCRIPT" open "$target_open"; fi
                pause_dashboard ;;
            18|c|C)
                echo "Clipboard actions: 1) paste (read)  2) copy (write)"
                read -r -p "Select action [1-2]: " c_act
                case "$c_act" in
                    2) read -r -p "Text to copy to clipboard: " c_text; bash "$REAL_SCRIPT" clip copy "$c_text" ;;
                    *) bash "$REAL_SCRIPT" clip paste ;;
                esac
                pause_dashboard ;;
            19|n|N)
                read -r -p "Message text: " n_text
                if [ -n "$n_text" ]; then bash "$REAL_SCRIPT" toast "$n_text"; fi
                pause_dashboard ;;
            20|p|P) process_manager ;;
            21|t|T) bash "$REAL_SCRIPT" thermal; pause_dashboard ;;
            22) bash "$REAL_SCRIPT" doctor; pause_dashboard ;;
            23) bash "$REAL_SCRIPT" gpu; pause_dashboard ;;
            h|H) show_help; pause_dashboard ;;
            r|R|"") ;;
            w|W) watch_dashboard ;;
            q|Q) return 0 ;;
            *) echo "Invalid option: ${choice:-empty}"; pause_dashboard ;;
        esac
    done
}

case "${1:-}" in
    dashboard|menu|ui)
        dashboard
        ;;
    overview)
        overview
        ;;
    watch|monitor)
        watch_dashboard
        ;;
    ps|top|processes)
        process_manager
        ;;
    start)
        bash "$ASL_DIR/core/mount-chroot.sh" || exit 1
        ;;
    stop)
        bash "$ASL_DIR/desktop/start-desktop.sh" stop \
            || echo "[!] Desktop shutdown reported an error; continuing to unmount chroot."
        bash "$ASL_DIR/core/stop-chroot.sh"
        ;;
    doctor)
        bash "$ASL_DIR/core/doctor.sh"
        ;;
    status)
        echo "=== ASL Status ==="
        if is_mounted; then
            echo " Status:   ACTIVE (Mounted)"
        else
            echo " Status:   INACTIVE (Unmounted)"
        fi
        echo " Location: $DEBIANPATH"
        SIZE=$(su -c "du -shx '$DEBIANPATH' 2>/dev/null | cut -f1")
        echo " Size:     ${SIZE:-Unknown}"

        if is_mounted; then
            echo ""
            echo "Active Sub-mounts:"
            su -c "grep '$DEBIANPATH' /proc/mounts | awk '{print \" - \" \$2 \" (\" \$3 \")\"}'" 2>/dev/null
        fi
        ;;
    shell|enter)
        shift
        TARGET_USER="${1:-root}"
        if ! is_mounted; then
            bash "$ASL_DIR/core/mount-chroot.sh" || exit 1
        fi
        if [ "$TARGET_USER" = "root" ]; then
            exec su -c "chroot '$DEBIANPATH' /bin/bash --noprofile --norc -c 'export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin TERM=xterm LANG=C.UTF-8 LC_ALL=C.UTF-8; exec /bin/bash --login'"
        fi
        if [[ ! "$TARGET_USER" =~ ^[a-z_][a-z0-9_-]*\$?$ ]]; then
            echo "Error: Invalid Debian username."
            exit 1
        fi
        if ! su -c "chroot '$DEBIANPATH' id '$TARGET_USER'" >/dev/null 2>&1; then
            echo "Error: User '$TARGET_USER' does not exist in Debian chroot."
            exit 1
        fi
        exec su -c "chroot '$DEBIANPATH' /bin/su -l '$TARGET_USER'"
        ;;
    exec|run)
        shift
        if [ $# -eq 0 ]; then
            echo "Error: No command specified. Usage: asl exec <command>"
            exit 1
        fi
        if ! is_mounted; then
            bash "$ASL_DIR/core/mount-chroot.sh" || exit 1
        fi
        run_in_chroot "$@"
        ;;
    game|wine)
        shift
        if ! is_mounted; then
            bash "$ASL_DIR/core/mount-chroot.sh" || exit 1
        fi
        bash "$ASL_DIR/gaming/wine-box64.sh" "$@"
        ;;
    setup-gaming|setup)
        if ! is_mounted; then
            bash "$ASL_DIR/core/mount-chroot.sh" || exit 1
        fi
        bash "$ASL_DIR/gaming/wine-box64.sh" setup
        ;;
    benchmark|bench)
        if ! is_mounted; then
            bash "$ASL_DIR/core/mount-chroot.sh" || exit 1
        fi
        bash "$ASL_DIR/gaming/wine-box64.sh" benchmark
        ;;
    gpu)
        bash "$ASL_DIR/core/gpu-detect.sh"
        ;;
    thermal|temp)
        bash "$ASL_DIR/core/thermal.sh"
        ;;
    theme)
        shift
        bash "$ASL_DIR/desktop/theme.sh" "$@"
        ;;
    snapshot)
        shift
        bash "$ASL_DIR/core/snapshot.sh" "$@"
        ;;
    remote)
        shift
        bash "$ASL_DIR/desktop/remote.sh" "$@"
        ;;
    desktop)
        shift
        DESKTOP_ACTION="${1:-start}"
        case "$DESKTOP_ACTION" in start|stop|force-stop|kill|restart|status|refresh-x11|sync-apps|launch) ;; *) echo "Error: desktop accepts start, stop, force-stop, restart, status, sync-apps, launch, or refresh-x11."; exit 1 ;; esac
        if [[ "$DESKTOP_ACTION" = start || "$DESKTOP_ACTION" = restart || "$DESKTOP_ACTION" = sync-apps || "$DESKTOP_ACTION" = launch ]] && ! is_mounted; then
            bash "$ASL_DIR/core/mount-chroot.sh" || exit 1
        fi
        shift || true
        bash "$ASL_DIR/desktop/start-desktop.sh" "$DESKTOP_ACTION" "$@"
        ;;
    install)
        shift
        if [ $# -eq 0 ]; then
            echo "Usage: asl install <package_name...>"
            exit 1
        fi
        pkg=
        for pkg in "$@"; do
            if [[ ! "$pkg" =~ ^[A-Za-z0-9][A-Za-z0-9.+_-]*$ ]]; then
                echo "Error: Invalid package name: $pkg"
                exit 1
            fi
        done
        unset pkg
        if ! is_mounted; then
            bash "$ASL_DIR/core/mount-chroot.sh" || exit 1
        fi
        echo "[*] Updating package lists and installing: $*..."
        run_in_chroot "apt-get update && apt-get install -y $*"
        ;;
    search)
        shift
        if [ $# -eq 0 ]; then
            echo "Usage: asl search <query>"
            exit 1
        fi
        term=
        for term in "$@"; do
            if [[ ! "$term" =~ ^[A-Za-z0-9][A-Za-z0-9.+:_-]*$ ]]; then
                echo "Error: Invalid search term: $term"
                exit 1
            fi
        done
        unset term
        if ! is_mounted; then
            bash "$ASL_DIR/core/mount-chroot.sh" || exit 1
        fi
        run_in_chroot "apt-cache search $*"
        ;;
    mode)
        shift
        TARGET_MODE="${1:-status}"
        MODE_STATE="/data/local/tmp/asl_mode_state"
        case "$TARGET_MODE" in
            gaming|game)
                echo "[*] Applying Gaming Performance Profile & CPU Governor..."
                su -c "sync; echo 3 > /proc/sys/vm/drop_caches; echo 1 > /proc/sys/vm/compact_memory" 2>/dev/null || true
                su -c "for g in /sys/devices/system/cpu/cpu*/cpufreq/scaling_governor; do echo performance > \"\$g\" 2>/dev/null || true; done" 2>/dev/null || true
                su -c "echo noconform > '$MODE_STATE'" 2>/dev/null || true
                echo "[✓] Gaming mode active: RAM compacted, CPU governor set to performance, Turnip flags enabled."
                ;;
            performance|perf)
                echo "[*] Applying Maximum Performance Mode..."
                su -c "sync; echo 3 > /proc/sys/vm/drop_caches; echo 1 > /proc/sys/vm/compact_memory" 2>/dev/null || true
                su -c "for g in /sys/devices/system/cpu/cpu*/cpufreq/scaling_governor; do echo performance > \"\$g\" 2>/dev/null || true; done" 2>/dev/null || true
                su -c "echo noconform > '$MODE_STATE'" 2>/dev/null || true
                echo "[✓] Performance mode active: RAM freed, CPU governor set to performance."
                ;;
            balanced|normal)
                su -c "for g in /sys/devices/system/cpu/cpu*/cpufreq/scaling_governor; do echo schedutil > \"\$g\" 2>/dev/null || echo powersave > \"\$g\" 2>/dev/null || true; done" 2>/dev/null || true
                su -c "rm -f '$MODE_STATE'" 2>/dev/null || true
                unset TU_DEBUG
                echo "[✓] Balanced profile active: CPU governor reset."
                ;;
            status|"")
                GOV=$(cat /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor 2>/dev/null || echo "unknown")
                TU_MODE=$(su -c "cat '$MODE_STATE' 2>/dev/null" 2>/dev/null | tr -d '[:space:]')
                if [ -n "$TU_MODE" ]; then
                    echo "Current Profile Mode: Gaming ($TU_MODE) | Governor: $GOV"
                else
                    echo "Current Profile Mode: Balanced | Governor: $GOV"
                fi
                ;;
            *)
                echo "Usage: asl mode [gaming|performance|balanced|status]"
                exit 1
                ;;
        esac
        ;;
    resolution|res)
        shift
        RES="${1:-status}"
        SCALE="${2:-}"
        case "$RES" in
            720p)
                pkill -f "termux-x11.*:[0-9]" 2>/dev/null || true
                termux-x11 :0 -geometry 1280x720 +iglx -ac >/dev/null 2>&1 &
                echo "[✓] Termux:X11 display resolution set to 1280x720."
                ;;
            1080p)
                pkill -f "termux-x11.*:[0-9]" 2>/dev/null || true
                termux-x11 :0 -geometry 1920x1080 +iglx -ac >/dev/null 2>&1 &
                echo "[✓] Termux:X11 display resolution set to 1920x1080."
                ;;
            native)
                pkill -f "termux-x11.*:[0-9]" 2>/dev/null || true
                termux-x11 :0 +iglx -ac >/dev/null 2>&1 &
                echo "[✓] Termux:X11 display resolution set to native."
                ;;
            status|"")
                echo "Usage: asl resolution [720p|1080p|native] [scale]"
                ;;
            *)
                echo "Error: Invalid resolution preset '$RES'. Use: 720p, 1080p, native"
                exit 1
                ;;
        esac
        if [ "$RES" = 720p ] || [ "$RES" = 1080p ] || [ "$RES" = native ]; then
            bash "$ASL_DIR/desktop/start-desktop.sh" refresh-x11 >/dev/null 2>&1 || true
        fi
        if is_mounted && [ -n "$SCALE" ]; then
            if [[ "$SCALE" =~ ^[0-9]+(\.[0-9]+)?$ ]]; then
                run_in_chroot "DISPLAY=:0 xfconf-query -c xsettings -p /Gtk/ScaleFactor -s $SCALE 2>/dev/null || true"
            else
                echo "Error: Scale must be a number (e.g. 1.25)."
            fi
        fi
        ;;
    service)
        shift
        ACTION="${1:-status}"
        SVC="${2:-}"
        if [ -z "$SVC" ]; then
            echo "Usage: asl service <start|stop|restart|status> <service_name>"
            exit 1
        fi
        case "$ACTION" in
            start|stop|restart|status) ;;
            *) echo "Error: Invalid service action: $ACTION"; exit 1 ;;
        esac
        if [[ ! "$SVC" =~ ^[A-Za-z0-9._-]+$ ]]; then
            echo "Error: Invalid service name: $SVC"
            exit 1
        fi
        if ! is_mounted; then
            bash "$ASL_DIR/core/mount-chroot.sh" || exit 1
        fi
        run_in_chroot "service '$SVC' '$ACTION'"
        ;;
    audio)
        shift
        bash "$ASL_DIR/desktop/start-desktop.sh" audio "$@"
        ;;
    backup)
        BACKUP_DIR="/sdcard/Debian_Backups"
        if is_mounted; then
            echo "[!] Stopping chroot before backup..."
            bash "$ASL_DIR/core/stop-chroot.sh" || exit 1
        fi
        mkdir -p "$BACKUP_DIR" 2>/dev/null || BACKUP_DIR="/data/data/com.termux/files/home"
        BACKUP_FILE="$BACKUP_DIR/asl-backup-$(date +%Y%m%d_%H%M%S).tar.gz"
        PARTIAL_BACKUP="$BACKUP_FILE.partial"

        required_mb=$(su -c "du -sm '$DEBIANPATH' 2>/dev/null" | awk '{print $1}')
        target_free_mb=$(df -m "$BACKUP_DIR" 2>/dev/null | awk 'NR==2 {print $4}')
        if [ -n "$required_mb" ] && [ -n "$target_free_mb" ] && [ "$target_free_mb" -lt "$required_mb" ]; then
            echo "[!] Insufficient disk space in $BACKUP_DIR: ${target_free_mb}MB free, ~${required_mb}MB needed."
            exit 1
        fi

        echo "[*] Creating backup at $BACKUP_FILE..."
        if su -c "export PATH=\"/data/data/com.termux/files/usr/bin:/system/bin:\$PATH\"; tar --warning=no-file-changed -czf '$PARTIAL_BACKUP' --exclude='./dev*' --exclude='./proc*' --exclude='./sys*' --exclude='./run*' --exclude='./tmp*' -C '$DEBIANPATH' ." && su -c "test -s '$PARTIAL_BACKUP'"; then
            su -c "mv '$PARTIAL_BACKUP' '$BACKUP_FILE'"
            echo "[✓] Backup completed: $BACKUP_FILE"
        else
            su -c "rm -f '$PARTIAL_BACKUP'" 2>/dev/null || true
            echo "[!] Backup failed; no completed archive was created."
            exit 1
        fi
        ;;
    restore)
        shift
        RESTORE_FILE="${1:-}"
        if [ -z "$RESTORE_FILE" ] || [ ! -f "$RESTORE_FILE" ]; then
            echo "Error: Valid archive file required. Usage: asl restore <path/to/backup.tar.gz>"
            exit 1
        fi
        BASE64_BIN=$(command -v base64) || {
            echo "Error: base64 is required to restore an archive."
            exit 1
        }
        restore_b64=$(printf '%s' "$RESTORE_FILE" | "$BASE64_BIN" | tr -d '\n')
        if ! su -c "export PATH=\"/data/data/com.termux/files/usr/bin:/system/bin:\$PATH\"; archive=\$(printf %s '$restore_b64' | '$BASE64_BIN' -d); tar -tzf \"\$archive\" >/dev/null && ! tar -tzf \"\$archive\" | grep -Eq '(^/|(^|/)\.\.(/|\$))'"; then
            echo "[!] Restore archive is unreadable or contains unsafe paths."
            exit 1
        fi

        archive_size_mb=$(du -sm "$RESTORE_FILE" 2>/dev/null | awk '{print $1 * 3}')
        target_free_mb=$(df -m "$DEBIANPATH" 2>/dev/null | awk 'NR==2 {print $4}')
        if [ -n "$archive_size_mb" ] && [ -n "$target_free_mb" ] && [ "$target_free_mb" -lt "$archive_size_mb" ]; then
            echo "[!] Insufficient disk space on root filesystem: ${target_free_mb}MB free, ~${archive_size_mb}MB estimated needed."
            exit 1
        fi
        if is_mounted; then
            echo "[!] Stopping chroot..."
            bash "$ASL_DIR/core/stop-chroot.sh" || exit 1
        fi
        echo "[*] Staging restore from $RESTORE_FILE..."
        su -c "export PATH=\"/data/data/com.termux/files/usr/bin:/system/bin:\$PATH\"; archive=\$(printf %s '$restore_b64' | '$BASE64_BIN' -d); target='$DEBIANPATH'; parent=\${target%/*}; stage=\$(mktemp -d \"\$parent/.asl-restore.XXXXXX\") || exit 1; trap 'rm -rf \"\$stage\"' EXIT; tar -xzf \"\$archive\" -C \"\$stage\" || exit 1; rollback=\"\$target.pre-restore-\$(date +%Y%m%d_%H%M%S)\"; test ! -e \"\$rollback\" || exit 1; if ! mv \"\$target\" \"\$rollback\"; then echo '[!] Restore failed: could not move current root aside.' >&2; exit 1; fi; if ! mv \"\$stage\" \"\$target\"; then echo '[!] Restore failed: moving staged root into place failed; rolling back original root.' >&2; mv \"\$rollback\" \"\$target\" 2>/dev/null || true; exit 1; fi; stage=; trap - EXIT; printf '[✓] Restore completed. Previous Debian root retained at: %s\\n' \"\$rollback\"" || {
            echo "[!] Restore failed; the Debian root is unchanged (or was rolled back)."
            exit 1
        }
        ;;
    wakelock|wake|open|clip|clipboard|toast|notify|notification|storage)
        bash "$ASL_DIR/core/termux-bridge.sh" "$@"
        ;;
    aid|gids)
        shift
        bash "$ASL_DIR/core/android-aid.sh" "$@"
        ;;
    help|-h|--help)
        show_help
        ;;
    "")
        dashboard
        ;;
    *)
        if ! is_mounted; then
            bash "$ASL_DIR/core/mount-chroot.sh" || exit 1
        fi
        run_in_chroot "$*"
        ;;
esac
