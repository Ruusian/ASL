#!/bin/bash
# AndroidLinux-SuperKit: Unified CLI Management Console
# Combines Root Chroot + MoBox Gaming + Termux-Desktops

REAL_SCRIPT="$(readlink -f "${BASH_SOURCE[0]}")"
SUPERKIT_DIR="$(cd "$(dirname "$REAL_SCRIPT")/.." && pwd)"
if [ ! -d "$SUPERKIT_DIR/core" ] && [ -d "$HOME/AndroidLinux-SuperKit/core" ]; then
    SUPERKIT_DIR="$HOME/AndroidLinux-SuperKit"
fi
DEBIANPATH="${DEBIANPATH:-/data/local/tmp/chrootDebian}"

export SUPERKIT_DIR DEBIANPATH

if [ -t 1 ] && [ "${NO_COLOR:-}" = "" ]; then
    C_RESET=$'\033[0m'
    C_BOLD=$'\033[1m'
    C_CYAN=$'\033[36m'
    C_GREEN=$'\033[32m'
    C_YELLOW=$'\033[33m'
    C_RED=$'\033[31m'
    C_DIM=$'\033[2m'
else
    C_RESET= C_BOLD= C_CYAN= C_GREEN= C_YELLOW= C_RED= C_DIM=
fi

status_label() {
    local state="$1"
    case "$state" in
        ACTIVE|RUNNING|READY) printf '%s%s%s' "$C_GREEN" "$state" "$C_RESET" ;;
        INACTIVE|STOPPED) printf '%s%s%s' "$C_DIM" "$state" "$C_RESET" ;;
        *) printf '%s%s%s' "$C_YELLOW" "$state" "$C_RESET" ;;
    esac
}

section_title() { printf '%s%s%s\n' "$C_CYAN$C_BOLD" "$1" "$C_RESET"; }
menu_item() { printf '  %s%2s%s) %s\n' "$C_CYAN" "$1" "$C_RESET" "$2"; }

if [ "$DEBIANPATH" != "/data/local/tmp/chrootDebian" ]; then
    echo "Error: DEBIANPATH must be /data/local/tmp/chrootDebian"
    exit 2
fi

is_mounted() {
    su -c "grep -q -w '$DEBIANPATH/proc' /proc/mounts" 2>/dev/null
}

run_in_chroot() {
    local command_text="$1"
    local command_b64

    command_b64=$(printf '%s' "$command_text" | base64 | tr -d '\n')
    su -c "chroot '$DEBIANPATH' /bin/bash --noprofile --norc -c 'export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin TERM=xterm LANG=C.UTF-8 LC_ALL=C.UTF-8; printf %s $command_b64 | /usr/bin/base64 -d | /bin/bash'"
}

show_help() {
    echo "============================================================"
    echo "       AndroidLinux-SuperKit Console v1.0"
    echo "  Combined Native Chroot + MoBox Gaming + Termux Desktops"
    echo "============================================================"
    echo "Usage: superkit [dashboard|command] [args]"
    echo ""
    echo "Dashboard:"
    echo "  dashboard, menu  Open the interactive terminal dashboard"
    echo "  overview         Show concise chroot, desktop, audio, X11, and GPU state"
    echo "  mode [gaming|performance|balanced] Configure performance profile"
    echo "  thermal          Display battery and CPU/GPU thermal temperatures"
    echo ""
    echo "Core Chroot Commands:"
    echo "  start            Start & mount Debian chroot safely"
    echo "  stop             Stop & unmount Debian chroot"
    echo "  status           Show chroot status, size, and mounts"
    echo "  doctor           Check SuperKit prerequisites without changing state"
    echo "  shell [user]     Enter interactive shell (default: root)"
    echo "  exec <cmd>       Execute a single command inside chroot"
    echo "  install <pkg..>  Install Debian packages via apt-get"
    echo "  search <query>   Search available Debian packages"
    echo "  service <act> <name> Manage Debian background services (start|stop|restart|status)"
    echo "  snapshot [act]   Fast chroot snapshots (create|list|restore|delete)"
    echo "  backup           Backup chroot to tar.gz archive"
    echo "  restore <file>   Restore chroot from tar.gz archive"
    echo ""
    echo "MoBox Gaming Commands:"
    echo "  setup-gaming     Auto-install Wine, Box64, DXVK, and VKD3D dependencies"
    echo "  game [exe]       Launch Windows .exe with Box64 + Wine"
    echo "  gpu              Detect SoC & configure Turnip/Zink/VirGL"
    echo ""
    echo "Termux Desktop & Remote Commands:"
    echo "  desktop start    Start SuperKit-managed XFCE4 desktop"
    echo "  desktop stop     Stop only the SuperKit-managed desktop"
    echo "  desktop status   Show desktop lifecycle status"
    echo "  desktop sync-apps Create SuperKit-owned Termux launchers"
    echo "  theme [preset]   Set XFCE look & feel (dark|light|nord|dracula)"
    echo "  resolution [preset] Set Termux:X11 display resolution (720p|1080p|native)"
    echo "  remote [ssh|vnc] Manage SSH/VNC remote access servers"
    echo "  audio [start|stop|test|volume <level>] Manage PulseAudio sound server"
    echo ""
    echo "Utility Commands:"
    echo "  help             Show this help message"
    echo ""
}

pause_dashboard() {
    echo ""
    read -r -p "Press Enter to return to the dashboard..." _
}

overview() {
    local desktop_state desktop_status desktop_detail x11_socket
    local mem_total mem_avail mem_used mem_pct disk_data load_avg
    x11_socket="${TMPDIR:-${PREFIX:-/data/data/com.termux/files/usr}/tmp}/.X11-unix/X0"
    desktop_state=$(bash "$SUPERKIT_DIR/desktop/start-desktop.sh" status 2>/dev/null | tr '\n' ' ')
    desktop_state=${desktop_state#Desktop: }
    desktop_state=${desktop_state% }
    desktop_status=${desktop_state%% *}
    desktop_detail=${desktop_state#"$desktop_status"}
    source "$SUPERKIT_DIR/core/gpu-profile.sh"
    superkit_gpu_detect

    mem_total=$(awk '/MemTotal/ {print int($2/1024)}' /proc/meminfo 2>/dev/null || echo 0)
    mem_avail=$(awk '/MemAvailable/ {print int($2/1024)}' /proc/meminfo 2>/dev/null || echo 0)
    if [ "$mem_total" -gt 0 ]; then
        mem_used=$((mem_total - mem_avail))
        mem_pct=$((mem_used * 100 / mem_total))
    else
        mem_used=0; mem_pct=0
    fi
    disk_data=$(df -h /data 2>/dev/null | awk 'NR==2 {print $4 " free of " $2}')
    load_avg=$(su -c "cat /proc/loadavg" 2>/dev/null | cut -d' ' -f1-3)
    [ -n "$load_avg" ] || load_avg="unknown"

    printf '%s=== AndroidLinux-SuperKit Overview ===%s\n' "$C_BOLD" "$C_RESET"
    if is_mounted; then printf ' Chroot:  '; status_label ACTIVE; echo; else printf ' Chroot:  '; status_label INACTIVE; echo; fi
    printf ' Desktop: '; status_label "${desktop_status:-UNKNOWN}"; printf '%s\n' "$desktop_detail"
    if [ -S "$x11_socket" ]; then printf ' X11:     '; status_label READY; printf ' (DISPLAY=:0)\n'; else printf ' X11:     '; status_label STOPPED; echo; fi
    if pgrep -x pulseaudio >/dev/null 2>&1; then printf ' Audio:   '; status_label RUNNING; echo; else printf ' Audio:   '; status_label STOPPED; echo; fi
    printf ' GPU:     %s%s%s (%s)\n' "$C_YELLOW" "$SUPERKIT_GPU_PROFILE" "$C_RESET" "${SUPERKIT_GPU_PLATFORM:-unknown}"
    printf ' Telemetry: RAM %s%dMB / %dMB (%d%%)%s | Data %s%s%s | Load %s%s%s\n' \
        "$C_CYAN" "$mem_used" "$mem_total" "$mem_pct" "$C_RESET" \
        "$C_CYAN" "${disk_data:-unknown}" "$C_RESET" \
        "$C_YELLOW" "${load_avg}" "$C_RESET"
}

process_manager() {
    while true; do
        clear 2>/dev/null || true
        printf '%s============================================================%s\n' "$C_CYAN$C_BOLD" "$C_RESET"
        printf '%s           SuperKit Resource & Process Manager%s\n' "$C_CYAN$C_BOLD" "$C_RESET"
        printf '%s============================================================%s\n\n' "$C_CYAN$C_BOLD" "$C_RESET"
        printf '%sTop CPU / Memory Processes:%s\n' "$C_CYAN$C_BOLD" "$C_RESET"
        su -c "ps -eo pid,user,%cpu,%mem,comm --sort=-%cpu | head -n 12" 2>/dev/null || ps aux | head -n 12
        echo ""
        echo "Actions:"
        echo "  1) Refresh list"
        echo "  2) Terminate process (SIGTERM)"
        echo "  3) Force kill process (SIGKILL)"
        echo "  4) Return to menu"
        echo ""
        read -r -p "Select action [1-4]: " pm_act
        case "$pm_act" in
            2)
                read -r -p "Enter PID to terminate: " target_pid
                if [[ "$target_pid" =~ ^[0-9]+$ ]]; then
                    su -c "kill '$target_pid'" 2>/dev/null && echo "[✓] Sent SIGTERM to PID $target_pid" || echo "[!] Failed to terminate PID $target_pid"
                else
                    echo "[!] Invalid PID format."
                fi
                pause_dashboard
                ;;
            3)
                read -r -p "Enter PID to force kill: " target_pid
                if [[ "$target_pid" =~ ^[0-9]+$ ]]; then
                    su -c "kill -9 '$target_pid'" 2>/dev/null && echo "[✓] Sent SIGKILL to PID $target_pid" || echo "[!] Failed to kill PID $target_pid"
                else
                    echo "[!] Invalid PID format."
                fi
                pause_dashboard
                ;;
            1) continue ;;
            4|*) break ;;
        esac
    done
}

watch_dashboard() {
    trap 'break' INT
    while true; do
        clear 2>/dev/null || true
        printf '%s============================================================%s\n' "$C_CYAN$C_BOLD" "$C_RESET"
        printf '%s    AndroidLinux-SuperKit Live Monitor (Press Ctrl+C to stop)%s\n' "$C_CYAN$C_BOLD" "$C_RESET"
        printf '%s============================================================%s\n' "$C_CYAN$C_BOLD" "$C_RESET"
        overview
        echo ""
        printf '%sActive High CPU Processes:%s\n' "$C_CYAN" "$C_RESET"
        su -c "ps -eo pid,user,%cpu,%mem,comm --sort=-%cpu | head -n 8" 2>/dev/null || true
        sleep 2
    done
    trap - INT
}

dashboard() {
    while true; do
        clear 2>/dev/null || true
        printf '%s============================================================%s\n' "$C_CYAN$C_BOLD" "$C_RESET"
        printf '%s          AndroidLinux-SuperKit Dashboard%s\n' "$C_CYAN$C_BOLD" "$C_RESET"
        printf '%s============================================================%s\n' "$C_CYAN$C_BOLD" "$C_RESET"
        overview
        echo ""
        section_title "  System & Resources"
        menu_item 1 "Detailed chroot status"
        menu_item 2 "Run read-only diagnostics"
        menu_item 3 "Show GPU profile"
        menu_item 4 "Resource & process manager"
        menu_item 5 "Thermal & battery monitor"
        echo ""
        section_title "  Debian & Maintenance"
        menu_item 6 "Start Debian chroot"
        menu_item 7 "Open Debian shell"
        menu_item 8 "Run a command in Debian"
        menu_item 9 "Chroot snapshots (fast backup/restore)"
        menu_item 10 "Back up Debian (tar.gz)"
        menu_item 11 "Restore Debian from backup"
        menu_item 12 "Stop and unmount Debian chroot"
        echo ""
        section_title "  Desktop & Remote"
        menu_item 13 "Start XFCE desktop (Termux:X11)"
        menu_item 14 "Restart XFCE desktop"
        menu_item 15 "Stop SuperKit desktop"
        menu_item 16 "Detailed desktop status"
        menu_item 17 "Sync Debian app launchers"
        menu_item 18 "Desktop theme switcher"
        menu_item 19 "Remote SSH / VNC manager"
        menu_item 20 "Start PulseAudio only"
        echo ""
        section_title "  Gaming"
        menu_item 21 "Setup Wine/Box64 gaming environment"
        menu_item 22 "Launch a Windows .exe (Wine + Box64)"
        echo ""
        printf '  %sh%s) Help  %sr%s) Refresh  %sw%s) Watch live  %sq%s) Exit%s\n\n' "$C_CYAN" "$C_RESET" "$C_CYAN" "$C_RESET" "$C_CYAN" "$C_RESET" "$C_CYAN" "$C_RESET"
        read -r -p "Select an option: " choice

        case "$choice" in
            1) bash "$REAL_SCRIPT" status; pause_dashboard ;;
            2) bash "$REAL_SCRIPT" doctor; pause_dashboard ;;
            3) bash "$REAL_SCRIPT" gpu; pause_dashboard ;;
            4) process_manager ;;
            5) bash "$REAL_SCRIPT" thermal; pause_dashboard ;;
            6) bash "$REAL_SCRIPT" start; pause_dashboard ;;
            7) bash "$REAL_SCRIPT" shell ;;
            8)
                read -r -p "Debian command: " command
                if [ -n "$command" ]; then bash "$REAL_SCRIPT" exec "$command"; fi
                pause_dashboard ;;
            9)
                echo "Snapshot actions: 1) list  2) create  3) restore  4) delete"
                read -r -p "Select action [1-4]: " s_act
                case "$s_act" in
                    1) bash "$REAL_SCRIPT" snapshot list ;;
                    2) read -r -p "Snapshot name: " s_name; bash "$REAL_SCRIPT" snapshot create "$s_name" ;;
                    3) read -r -p "Snapshot name to restore: " s_name; bash "$REAL_SCRIPT" snapshot restore "$s_name" ;;
                    4) read -r -p "Snapshot name to delete: " s_name; bash "$REAL_SCRIPT" snapshot delete "$s_name" ;;
                esac
                pause_dashboard ;;
            10)
                read -r -p "Create a Debian backup now? [y/N]: " confirm
                if [[ "$confirm" =~ ^[Yy]$ ]]; then bash "$REAL_SCRIPT" backup; fi
                pause_dashboard ;;
            11)
                read -r -p "Backup archive path: " archive
                if [ -n "$archive" ]; then
                    read -r -p "Restore replaces the current Debian filesystem. Continue? [y/N]: " confirm
                    if [[ "$confirm" =~ ^[Yy]$ ]]; then bash "$REAL_SCRIPT" restore "$archive"; fi
                fi
                pause_dashboard ;;
            12)
                read -r -p "Stop all chroot processes and unmount Debian? [y/N]: " confirm
                if [[ "$confirm" =~ ^[Yy]$ ]]; then bash "$REAL_SCRIPT" stop; fi
                pause_dashboard ;;
            13) bash "$REAL_SCRIPT" desktop start; pause_dashboard ;;
            14) bash "$REAL_SCRIPT" desktop restart; pause_dashboard ;;
            15) bash "$REAL_SCRIPT" desktop stop; pause_dashboard ;;
            16) bash "$REAL_SCRIPT" desktop status; pause_dashboard ;;
            17) bash "$REAL_SCRIPT" desktop sync-apps; pause_dashboard ;;
            18)
                echo "Presets: dark, light, nord, dracula, greybird"
                read -r -p "Select theme preset: " t_preset
                if [ -n "$t_preset" ]; then bash "$REAL_SCRIPT" theme "$t_preset"; fi
                pause_dashboard ;;
            19)
                echo "Remote actions: 1) SSH start  2) SSH stop  3) VNC start  4) VNC stop  5) status"
                read -r -p "Select action [1-5]: " r_act
                case "$r_act" in
                    1) bash "$REAL_SCRIPT" remote ssh start ;;
                    2) bash "$REAL_SCRIPT" remote ssh stop ;;
                    3) bash "$REAL_SCRIPT" remote vnc start ;;
                    4) bash "$REAL_SCRIPT" remote vnc stop ;;
                    *) bash "$REAL_SCRIPT" remote status ;;
                esac
                pause_dashboard ;;
            20) bash "$REAL_SCRIPT" audio; pause_dashboard ;;
            21) bash "$REAL_SCRIPT" setup-gaming; pause_dashboard ;;
            22)
                read -r -p "Full path to Windows .exe: " exe_path
                if [ -n "$exe_path" ]; then bash "$REAL_SCRIPT" game run "$exe_path"; fi
                pause_dashboard ;;
            h|H) show_help; pause_dashboard ;;
            r|R) ;;
            w|W) watch_dashboard ;;
            q|Q) return 0 ;;
            *) echo "Invalid option: ${choice:-empty}"; pause_dashboard ;;
        esac
    done
}

case "${1:-}" in
    dashboard|menu|ui)
        dashboard
        ;;
    overview)
        overview
        ;;
    watch|monitor)
        watch_dashboard
        ;;
    ps|top|processes)
        process_manager
        ;;
    start)
        bash "$SUPERKIT_DIR/core/mount-chroot.sh" || exit 1
        ;;
    stop)
        bash "$SUPERKIT_DIR/desktop/start-desktop.sh" stop || exit 1
        bash "$SUPERKIT_DIR/core/stop-chroot.sh"
        ;;
    doctor)
        bash "$SUPERKIT_DIR/core/doctor.sh"
        ;;
    status)
        echo "=== AndroidLinux-SuperKit Status ==="
        if is_mounted; then
            echo " Status:   ACTIVE (Mounted)"
        else
            echo " Status:   INACTIVE (Unmounted)"
        fi
        echo " Location: $DEBIANPATH"
        SIZE=$(su -c "du -shx '$DEBIANPATH' 2>/dev/null | cut -f1")
        echo " Size:     ${SIZE:-Unknown}"

        if is_mounted; then
            echo ""
            echo "Active Sub-mounts:"
            su -c "grep '$DEBIANPATH' /proc/mounts | awk '{print \" - \" \$2 \" (\" \$3 \")\"}'" 2>/dev/null
        fi
        ;;
    shell|enter)
        shift
        TARGET_USER="${1:-root}"
        if ! is_mounted; then
            bash "$SUPERKIT_DIR/core/mount-chroot.sh" || exit 1
        fi
        if [ "$TARGET_USER" = "root" ]; then
            exec su -c "chroot '$DEBIANPATH' /bin/bash --noprofile --norc -c 'export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin TERM=xterm LANG=C.UTF-8 LC_ALL=C.UTF-8; exec /bin/bash --login'"
        fi
        if [[ ! "$TARGET_USER" =~ ^[a-z_][a-z0-9_-]*\$?$ ]]; then
            echo "Error: Invalid Debian username."
            exit 1
        fi
        if ! su -c "chroot '$DEBIANPATH' id '$TARGET_USER'" >/dev/null 2>&1; then
            echo "Error: User '$TARGET_USER' does not exist in Debian chroot."
            exit 1
        fi
        exec su -c "chroot '$DEBIANPATH' /bin/su -l '$TARGET_USER'"
        ;;
    exec|run)
        shift
        if [ $# -eq 0 ]; then
            echo "Error: No command specified. Usage: superkit exec <command>"
            exit 1
        fi
        if ! is_mounted; then
            bash "$SUPERKIT_DIR/core/mount-chroot.sh" || exit 1
        fi
        run_in_chroot "$*"
        ;;
    game|wine)
        shift
        if ! is_mounted; then
            bash "$SUPERKIT_DIR/core/mount-chroot.sh" || exit 1
        fi
        bash "$SUPERKIT_DIR/gaming/wine-box64.sh" "$@"
        ;;
    setup-gaming|setup)
        if ! is_mounted; then
            bash "$SUPERKIT_DIR/core/mount-chroot.sh" || exit 1
        fi
        bash "$SUPERKIT_DIR/gaming/wine-box64.sh" setup
        ;;
    gpu)
        bash "$SUPERKIT_DIR/core/gpu-detect.sh"
        ;;
    thermal|temp)
        bash "$SUPERKIT_DIR/core/thermal.sh"
        ;;
    theme)
        shift
        bash "$SUPERKIT_DIR/desktop/theme.sh" "$@"
        ;;
    snapshot)
        shift
        bash "$SUPERKIT_DIR/core/snapshot.sh" "$@"
        ;;
    remote)
        shift
        bash "$SUPERKIT_DIR/desktop/remote.sh" "$@"
        ;;
    desktop)
        shift
        DESKTOP_ACTION="${1:-start}"
        case "$DESKTOP_ACTION" in start|stop|force-stop|kill|restart|status|sync-apps|launch) ;; *) echo "Error: desktop accepts start, stop, force-stop, restart, status, sync-apps, or launch."; exit 1 ;; esac
        if [[ "$DESKTOP_ACTION" = start || "$DESKTOP_ACTION" = restart || "$DESKTOP_ACTION" = sync-apps || "$DESKTOP_ACTION" = launch ]] && ! is_mounted; then
            bash "$SUPERKIT_DIR/core/mount-chroot.sh" || exit 1
        fi
        shift || true
        bash "$SUPERKIT_DIR/desktop/start-desktop.sh" "$DESKTOP_ACTION" "$@"
        ;;
    install)
        shift
        if [ $# -eq 0 ]; then
            echo "Usage: superkit install <package_name...>"
            exit 1
        fi
        if ! is_mounted; then
            bash "$SUPERKIT_DIR/core/mount-chroot.sh" || exit 1
        fi
        echo "[*] Updating package lists and installing: $*..."
        run_in_chroot "apt-get update && apt-get install -y $*"
        ;;
    search)
        shift
        if [ $# -eq 0 ]; then
            echo "Usage: superkit search <query>"
            exit 1
        fi
        if ! is_mounted; then
            bash "$SUPERKIT_DIR/core/mount-chroot.sh" || exit 1
        fi
        run_in_chroot "apt-cache search $*"
        ;;
    mode)
        shift
        TARGET_MODE="${1:-status}"
        case "$TARGET_MODE" in
            gaming|game)
                echo "[*] Applying Gaming Performance Mode..."
                su -c "sync; echo 3 > /proc/sys/vm/drop_caches; echo 1 > /proc/sys/vm/compact_memory" 2>/dev/null || true
                export TU_DEBUG=noconform
                echo "[✓] Gaming mode active: RAM compacted, Turnip performance flags set."
                ;;
            performance|perf)
                echo "[*] Applying Maximum Performance Mode..."
                su -c "sync; echo 3 > /proc/sys/vm/drop_caches; echo 1 > /proc/sys/vm/compact_memory" 2>/dev/null || true
                echo "[✓] Performance mode active: RAM freed."
                ;;
            balanced|normal)
                unset TU_DEBUG
                echo "[✓] Balanced profile active."
                ;;
            status|"")
                echo "Current Mode: ${TU_DEBUG:+Gaming (noconform)}${TU_DEBUG:-Balanced}"
                ;;
            *)
                echo "Usage: superkit mode [gaming|performance|balanced|status]"
                exit 1
                ;;
        esac
        ;;
    resolution|res)
        shift
        RES="${1:-status}"
        SCALE="${2:-}"
        case "$RES" in
            720p)
                pkill -f "termux-x11.*:[0-9]" 2>/dev/null || true
                termux-x11 :0 -geometry 1280x720 +iglx -ac >/dev/null 2>&1 &
                echo "[✓] Termux:X11 display resolution set to 1280x720."
                ;;
            1080p)
                pkill -f "termux-x11.*:[0-9]" 2>/dev/null || true
                termux-x11 :0 -geometry 1920x1080 +iglx -ac >/dev/null 2>&1 &
                echo "[✓] Termux:X11 display resolution set to 1920x1080."
                ;;
            native)
                pkill -f "termux-x11.*:[0-9]" 2>/dev/null || true
                termux-x11 :0 +iglx -ac >/dev/null 2>&1 &
                echo "[✓] Termux:X11 display resolution set to native."
                ;;
            status|"")
                echo "Usage: superkit resolution [720p|1080p|native] [scale]"
                ;;
            *)
                echo "Error: Invalid resolution preset '$RES'. Use: 720p, 1080p, native"
                exit 1
                ;;
        esac
        if is_mounted && [ -n "$SCALE" ]; then
            run_in_chroot "DISPLAY=:0 xfconf-query -c xsettings -p /Gtk/ScaleFactor -s $SCALE 2>/dev/null || true"
        fi
        ;;
    service)
        shift
        ACTION="${1:-status}"
        SVC="${2:-}"
        if [ -z "$SVC" ]; then
            echo "Usage: superkit service <start|stop|restart|status> <service_name>"
            exit 1
        fi
        if ! is_mounted; then
            bash "$SUPERKIT_DIR/core/mount-chroot.sh" || exit 1
        fi
        run_in_chroot "service '$SVC' '$ACTION'"
        ;;
    audio)
        shift
        bash "$SUPERKIT_DIR/desktop/start-desktop.sh" audio "$@"
        ;;
    backup)
        BACKUP_DIR="/sdcard/Debian_Backups"
        if is_mounted; then
            echo "[!] Stopping chroot before backup..."
            bash "$SUPERKIT_DIR/core/stop-chroot.sh" || exit 1
        fi
        mkdir -p "$BACKUP_DIR" 2>/dev/null || BACKUP_DIR="/data/data/com.termux/files/home"
        BACKUP_FILE="$BACKUP_DIR/superkit-backup-$(date +%Y%m%d_%H%M%S).tar.gz"
        PARTIAL_BACKUP="$BACKUP_FILE.partial"

        local required_mb target_free_mb
        required_mb=$(su -c "du -sm '$DEBIANPATH' 2>/dev/null" | awk '{print $1}')
        target_free_mb=$(df -m "$BACKUP_DIR" 2>/dev/null | awk 'NR==2 {print $4}')
        if [ -n "$required_mb" ] && [ -n "$target_free_mb" ] && [ "$target_free_mb" -lt "$required_mb" ]; then
            echo "[!] Insufficient disk space in $BACKUP_DIR: ${target_free_mb}MB free, ~${required_mb}MB needed."
            exit 1
        fi

        echo "[*] Creating backup at $BACKUP_FILE..."
        if su -c "tar -czf '$PARTIAL_BACKUP' -C '$DEBIANPATH' ." && su -c "test -s '$PARTIAL_BACKUP'"; then
            mv "$PARTIAL_BACKUP" "$BACKUP_FILE"
            echo "[✓] Backup completed: $BACKUP_FILE"
        else
            rm -f "$PARTIAL_BACKUP"
            echo "[!] Backup failed; no completed archive was created."
            exit 1
        fi
        ;;
    restore)
        shift
        RESTORE_FILE="${1:-}"
        if [ -z "$RESTORE_FILE" ] || [ ! -f "$RESTORE_FILE" ]; then
            echo "Error: Valid archive file required. Usage: superkit restore <path/to/backup.tar.gz>"
            exit 1
        fi
        BASE64_BIN=$(command -v base64) || {
            echo "Error: base64 is required to restore an archive."
            exit 1
        }
        restore_b64=$(printf '%s' "$RESTORE_FILE" | "$BASE64_BIN" | tr -d '\n')
        if ! su -c "archive=\$(printf %s '$restore_b64' | '$BASE64_BIN' -d); tar -tzf \"\$archive\" >/dev/null && ! tar -tzf \"\$archive\" | grep -Eq '(^/|(^|/)\.\.(/|\$))'"; then
            echo "[!] Restore archive is unreadable or contains unsafe paths."
            exit 1
        fi

        local archive_size_mb target_free_mb
        archive_size_mb=$(du -sm "$RESTORE_FILE" 2>/dev/null | awk '{print $1 * 3}')
        target_free_mb=$(df -m "$DEBIANPATH" 2>/dev/null | awk 'NR==2 {print $4}')
        if [ -n "$archive_size_mb" ] && [ -n "$target_free_mb" ] && [ "$target_free_mb" -lt "$archive_size_mb" ]; then
            echo "[!] Insufficient disk space on root filesystem: ${target_free_mb}MB free, ~${archive_size_mb}MB estimated needed."
            exit 1
        fi
        if is_mounted; then
            echo "[!] Stopping chroot..."
            bash "$SUPERKIT_DIR/core/stop-chroot.sh" || exit 1
        fi
        echo "[*] Staging restore from $RESTORE_FILE..."
        su -c "archive=\$(printf %s '$restore_b64' | '$BASE64_BIN' -d); target='$DEBIANPATH'; parent=\${target%/*}; stage=\$(mktemp -d \"\$parent/.superkit-restore.XXXXXX\") || exit 1; trap 'rm -rf \"\$stage\"' EXIT; tar -xzf \"\$archive\" -C \"\$stage\" || exit 1; rollback=\"\$target.pre-restore-\$(date +%Y%m%d_%H%M%S)\"; test ! -e \"\$rollback\" || exit 1; mv \"\$target\" \"\$rollback\" && mv \"\$stage\" \"\$target\" || exit 1; stage=; trap - EXIT; printf '[✓] Restore completed. Previous Debian root retained at: %s\\n' \"\$rollback\"" || {
            echo "[!] Restore failed; the existing Debian root was left unchanged."
            exit 1
        }
        ;;
    help|-h|--help)
        show_help
        ;;
    "")
        dashboard
        ;;
    *)
        if ! is_mounted; then
            bash "$SUPERKIT_DIR/core/mount-chroot.sh" || exit 1
        fi
        run_in_chroot "$*"
        ;;
esac
